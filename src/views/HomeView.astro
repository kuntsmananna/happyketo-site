---
/** Homepage body (both languages): the original's sections, in its order, plus the latest-recipes row (Anna's choice). */
import Hero from '@/components/Hero.astro';
import ChallengeBlock from '@/components/ChallengeBlock.astro';
import LatestRecipes from '@/components/LatestRecipes.astro';
import PhotoBand from '@/components/PhotoBand.astro';
import AboutBlock from '@/components/AboutBlock.astro';
import CuisineBlock from '@/components/CuisineBlock.astro';
import ServiceTrio from '@/components/ServiceTrio.astro';
import NewsletterForm from '@/components/NewsletterForm.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import JsonLd from '@/components/JsonLd.astro';
import { getLang } from '@/i18n';
import { siteJsonLd } from '@/lib/schema';

const lang = getLang(Astro.url);
---

<JsonLd data={siteJsonLd(lang)} />
<Hero />
<ChallengeBlock />
<LatestRecipes />
<PhotoBand />
<AboutBlock />
<CuisineBlock />
<ServiceTrio />
<NewsletterForm />
<FaqAccordion openFirst />
