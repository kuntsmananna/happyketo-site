---
/**
 * Contact page (both languages): the original's centered lines (20px, two groups with a blank line between).
 * Text only, like the original (no form).
 */
import { site } from '@/data/site';
import { getLang } from '@/i18n';

const lang = getLang(Astro.url);
const ig = site.social[0];

const copy = {
  he: {
    title: 'היי! שמחה שאתם כאן.',
    intro:
      'יש לכם שאלה על אחד המתכונים?\nרוצים להתייעץ לגבי אתגר הקיטו או לשמוע עוד על הקורסים שלי?\nאני כאן לכל שאלה, מחשבה או שיתוף בתהליך שלכם.',
    ways: 'ניתן ליצור איתי קשר בכמה דרכים:',
    instagram: 'מוזמנים לעקוב ולכתוב לי בפרטי באינסטגרם',
  },
  en: {
    title: 'Hi! Glad you’re here.',
    intro:
      'Do you have a question about one of the recipes?\nWant to get advice about the keto challenge or hear more about my courses?\nI am here for any questions, thoughts, or sharing in your process.',
    ways: 'You can contact me in several ways:',
    instagram: 'You are welcome to follow and write to me privately on Instagram',
  },
}[lang];
---

<section class="bg-cream-100 px-[6%] pt-10 pb-6 text-center text-[1.3rem] leading-[1.4] text-bark-800 lg:px-0 lg:pt-[49px] lg:pb-[75px] lg:text-xl">
  <div class="mx-auto lg:w-[980px]">
    <h1 class="font-sans text-[length:inherit] leading-[inherit] text-bark-800">{copy.title}</h1>
    <p class="whitespace-pre-line">{copy.intro}</p>
    <p class="mt-[1.4em]">{copy.ways}</p>
    <p><a href={`mailto:${site.contact.email}`} class="hover:underline">{site.contact.email}</a></p>
    <p><a href={site.contact.phoneHref} class="hover:underline" dir="ltr">{site.contact.phone.replace('-', '.')}</a></p>
    <p>
      {copy.instagram}{' '}
      <a href={ig.href} class="underline" target="_blank" rel="noopener" dir="ltr">{ig.handle}</a>
    </p>
  </div>
</section>
