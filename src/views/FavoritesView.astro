---
/**
 * Happy Favorites (both languages), laid out like the original: mustard "Keto Favorites • Happy Favorites" band,
 * then a full-width three-column masonry of product cards (photo + lime body, English product text, "Buy now").
 * Products fill the columns left to right, as on the original. Phones: one column.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ArrowLong from '@/components/ArrowLong.astro';
import Marquee from '@/components/Marquee.astro';
import { favorites } from '@/data/favorites';
import { getLang } from '@/i18n';

const lang = getLang(Astro.url);
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/favorites/*.{webp,jpg,jpeg,png,avif}', { eager: true });
// `image` is the path the admin panel stores (/src/assets/favorites/<file>); a missing file fails the build.
const imageFor = (path: string) => {
  const img = images[path]?.default;
  if (!img) throw new Error(`Pantry photo not found: ${path} (src/data/content/favorites.json)`);
  return img;
};
const title = lang === 'he' ? 'המזווה הקטוגני – מוצרים מומלצים' : 'The Ketogenic Pantry – recommended products';
// Desktop: three columns filled left to right; phones: one list in the original order (via `order`).
const columns = [0, 1, 2].map((c) => favorites.map((item, i) => ({ item, i })).filter(({ i }) => i % 3 === c));
---

<Marquee word="Favorites" />
<!-- Visible title (an addition, Anna's choice: the band is English and decorative). -->
<h1 data-reveal class="h-section mx-auto w-[88%] pt-10 pb-8 text-center lg:pt-14 lg:pb-12">{title}</h1>

<div class="bg-cream-100 pb-16 lg:pb-24" lang="en" dir="ltr">
  <div class="grid gap-5 lg:grid-cols-3">
    {
      columns.map((col) => (
        <ul class="contents lg:flex lg:flex-col lg:gap-5">
          {col.map(({ item, i }) => {
            const img = imageFor(item.image);
            return (
              <li data-reveal class="group flex flex-col" style={`order:${i}`}>
                <div class="relative aspect-[413/349] overflow-hidden bg-white">
                  {img && (
                    <Image
                      src={img}
                      alt={item.name}
                      widths={[413, 600, 826]}
                      sizes="(min-width: 1024px) 413px, 100vw"
                      class="hover-zoom absolute inset-0 size-full object-cover"
                    />
                  )}
                </div>
                <div class="bg-lime-100 px-[34px] pt-[26px] pb-7 text-xl leading-[1.4] text-forest-600 lg:px-8">
                  <h2 class="max-w-[290px] font-logo text-xl leading-[1.4] font-semibold text-forest-600">{item.name}</h2>
                  <p class="mt-8 underline underline-offset-2">Ingredients:</p>
                  <p class="mt-[18px]">{item.ingredients}</p>
                  {item.note && <p>{item.note}</p>}
                  <a
                    href={item.href}
                    target="_blank"
                    rel="sponsored noopener"
                    class="mt-12 inline-flex min-h-11 items-center gap-3 text-base tracking-wide transition-colors hover:text-mustard-400"
                  >
                    Buy now
                    <ArrowLong />
                  </a>
                </div>
              </li>
            );
          })}
        </ul>
      ))
    }
  </div>
</div>
