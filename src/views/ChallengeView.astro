---
/**
 * Challenge page (both languages), laid out like the original "אתגר קיטו" page: navy header and two plan cards
 * (454px, photo + cream body, square green button). Below: the original program page's text (plain lines),
 * and the sign-up form that replaces Wix's plan checkout (leads go to Anna via Web3Forms).
 * Kickstart photo: the original used a Wix stock photo (licensed for Wix only), so this is Anna's lettuce tacos.
 */
import { Image } from 'astro:assets';
import Web3Form from '@/components/Web3Form.astro';
import { challengeContent } from '@/data/content';
import { site } from '@/data/site';
import { getLang } from '@/i18n';
import planFull from '@/assets/home/challenge-eggs-kale.jpg';
import planFree from '@/assets/home/challenge-lettuce-tacos.jpg';

const lang = getLang(Astro.url);

// Page text: src/data/content/challenge.{he,en}.json (editable in the admin panel). The form labels and field names
// stay here: they are tied to the emails Anna receives.
const ui = {
  he: {
    questions: 'שאלות?',
    or: 'או',
    whatsapp: 'וואטסאפ',
    form: {
      subject: 'הרשמה לאתגר Going Keto – Happy Keto',
      success: 'איזה כיף! 🎉 קיבלתי את הפרטים ואחזור אליכם בהקדם לתיאום.',
      name: 'שם מלא *',
      phone: 'טלפון *',
      email: 'אימייל *',
      track: 'במה תרצו להתחיל? *',
      diet: 'סגנון תזונה',
      diets: ['רגילה (אוכלים הכל)', 'צמחונית', 'צמחונית + דגים'],
      notes: 'משהו שחשוב לי לדעת?',
      optional: '(לא חובה)',
      consent:
        'ידוע לי שהתוכנית אינה טיפול רפואי ואינה תחליף לייעוץ רפואי, ושאם יש לי בעיה רפואית או שאני נוטל/ת תרופות באופן קבוע – אתייעץ עם הרופא/ה לפני שמתחילים. *',
      consentValue: 'קראתי ומאשר/ת',
      send: 'שליחה',
      fields: { phone: 'טלפון', track: 'מסלול', diet: 'תזונה', notes: 'הערות', consent: 'אישור' },
    },
  },
  en: {
    questions: 'Questions?',
    or: 'or',
    whatsapp: 'WhatsApp',
    form: {
      subject: 'Challenge sign-up (EN) – Happy Keto',
      success: 'Wonderful! 🎉 I got your details and will be in touch soon.',
      name: 'Full name *',
      phone: 'Phone *',
      email: 'Email *',
      track: 'Where would you like to start? *',
      diet: 'Eating style',
      diets: ['Regular (I eat everything)', 'Vegetarian', 'Vegetarian + fish'],
      notes: 'Anything I should know?',
      optional: '(optional)',
      consent:
        'I understand the program is not medical treatment or a substitute for medical advice, and that if I have a medical condition or take medication regularly I will consult my doctor before starting. *',
      consentValue: 'I have read and agree',
      send: 'Send',
      fields: { phone: 'Phone', track: 'Plan', diet: 'Eating style', notes: 'Notes', consent: 'Consent' },
    },
  },
}[lang];
const text = challengeContent(lang);
const images = { free: planFree, full: planFull } as const;
const copy = {
  ...text,
  ...ui,
  // The form option keeps the plan's name and price (sent in the sign-up email).
  plans: text.plans.map((p) => ({ ...p, value: `${p.title} – ${p.subtitle} (${p.price})`, image: images[p.id] })),
};
const f = copy.form;
---

<section class="surface-navy px-[6%] pt-6 pb-12 text-center text-cream-100 lg:px-0 lg:pt-[88px] lg:pb-9">
  <h1 data-reveal class="h-section text-cream-100">{copy.title}</h1>
  <p data-reveal class="text-body mx-auto mt-3 whitespace-pre-line lg:mt-[30px] lg:w-[714px]">{copy.intro}</p>

  <div class="mx-auto mt-12 grid w-[75%] gap-12 lg:mt-[110px] lg:w-[940px] lg:grid-cols-2 lg:gap-8">
    {
      copy.plans.map((p) => (
        <article data-reveal class="group flex flex-col overflow-hidden bg-cream-100 text-bark-800 transition-[translate,box-shadow] duration-500 ease-(--ease-out-soft) hover:-translate-y-1.5 hover:shadow-[0_24px_48px_-20px_rgb(0_0_0/0.55)]">
          <Image
            src={p.image}
            alt={p.alt}
            width={908}
            height={682}
            fit="cover"
            widths={[480, 680, 908]}
            sizes="(min-width: 1024px) 454px, 75vw"
            class="hover-zoom aspect-[454/341] w-full object-cover"
          />
          <div class="flex flex-1 flex-col items-center px-[13%] pt-8 pb-6 text-center lg:px-8">
            <h2 class="h-card font-sans text-bark-800"><bdi>{p.title}</bdi></h2>
            <p class="mt-1 text-lg text-bark-700">{p.subtitle}</p>
            <p class="mt-6 text-[1.2rem] whitespace-nowrap lg:text-base">{p.price}</p>
            <a href="#register" data-plan={p.id} class="btn-secondary btn-lg mt-5 w-full lg:[--btn-w:0]">
              {copy.join}
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>

<!-- The original program page's text (plain lines, blank line between groups) -->
<section class="bg-cream-100 px-[6%] py-14 text-bark-800 lg:px-0 lg:py-20" aria-labelledby="program-title">
  <div data-reveal class="text-body mx-auto max-w-[648px]">
    <h2 id="program-title" class="h-section"><bdi>{copy.plans[1].title}</bdi> – {copy.plans[1].subtitle}</h2>
    <div class="mt-8 space-y-[1.4em]">
      <p>{copy.programLead}</p>
      <div>{copy.method.map((m) => <p>{m}</p>)}</div>
      <div>
        <p>{copy.expectTitle}</p>
        <p>{copy.expect[0]}</p>
      </div>
      {copy.expect.slice(1).map((e) => <p>{e}</p>)}
      <div>
        <p>{copy.howTitle}</p>
        <p>{copy.how}</p>
      </div>
    </div>
    <p class="mt-12 whitespace-nowrap">{copy.plans[1].price}</p>
    <a href="#register" data-plan="full" class="btn-secondary btn-lg mt-6">
      {copy.programJoin}
    </a>
  </div>
</section>

<!-- Registration -->
<section id="register" class="scroll-mt-24 bg-lime-100 section-y" aria-labelledby="register-title">
  <div class="container-page grid items-start gap-10 lg:grid-cols-[1fr_1.3fr]">
    <div data-reveal class="lg:sticky lg:top-28">
      <h2 id="register-title" class="h-section">{copy.registerTitle}</h2>
      <p class="mt-4 text-lg leading-relaxed text-forest-800">{copy.registerText}</p>
      <p class="mt-6 text-bark-700">
        {copy.questions}{' '}
        <a class="text-forest-700 underline" href={site.contact.whatsappHref} target="_blank" rel="noopener">{copy.whatsapp}</a>{' '}
        {copy.or}{' '}
        <a class="text-forest-700 underline" href={site.contact.phoneHref} dir="ltr">{site.contact.phone}</a>
      </p>
    </div>

    <Web3Form subject={f.subject} successMessage={f.success} class="card space-y-5 p-6 sm:p-8">
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="ch-name" class="field-label">{f.name}</label>
          <input id="ch-name" name="name" required maxlength="100" autocomplete="name" class="input-field w-full" />
        </div>
        <div>
          <label for="ch-phone" class="field-label">{f.phone}</label>
          <input id="ch-phone" name={f.fields.phone} type="tel" required maxlength="30" pattern="[\d\s\+\-\(\)]{9,}" autocomplete="tel" dir="ltr" class="input-field w-full rtl:text-end" />
        </div>
      </div>
      <div>
        <label for="ch-email" class="field-label">{f.email}</label>
        <input id="ch-email" name="email" type="email" required maxlength="200" autocomplete="email" dir="ltr" class="input-field w-full rtl:text-end" />
      </div>

      <fieldset>
        <legend class="mb-2 font-medium">{f.track}</legend>
        <div class="grid gap-3 sm:grid-cols-2">
          {
            copy.plans.map((p, i) => (
              <label class="flex cursor-pointer items-center gap-3 rounded-2xl border border-bark-300 px-4 py-3 transition-colors has-[:checked]:border-forest-600 has-[:checked]:bg-mint-50">
                <input type="radio" name={f.fields.track} value={p.value} data-plan-radio={p.id} required checked={i === 0} class="size-4 accent-forest-600" />
                <span class="flex flex-col">
                  <span class="font-semibold text-forest-700"><bdi>{p.title}</bdi></span>
                  <span class="text-bark-700">
                    {p.subtitle} · <strong class="font-semibold whitespace-nowrap">{p.price}</strong>
                  </span>
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div>
        <label for="ch-diet" class="field-label">{f.diet}</label>
        <select id="ch-diet" name={f.fields.diet} class="input-field w-full">
          {f.diets.map((d) => <option>{d}</option>)}
        </select>
      </div>

      <div>
        <label for="ch-notes" class="field-label">{f.notes} <span class="font-normal text-bark-500">{f.optional}</span></label>
        <textarea id="ch-notes" name={f.fields.notes} rows="3" maxlength="2000" class="input-field w-full resize-y"></textarea>
      </div>

      <label class="flex items-start gap-3 text-sm leading-relaxed text-bark-700">
        <input type="checkbox" name={f.fields.consent} value={f.consentValue} required class="mt-1 size-4 shrink-0 accent-forest-600" />
        <span>{f.consent}</span>
      </label>

      <button type="submit" class="btn-primary w-full text-lg">{f.send}</button>
    </Web3Form>
  </div>
</section>

<script>
  // Plan buttons preselect the matching option in the form.
  document.querySelectorAll<HTMLAnchorElement>('[data-plan]').forEach((a) =>
    a.addEventListener('click', () => {
      const radio = document.querySelector<HTMLInputElement>(`[data-plan-radio="${a.dataset.plan}"]`);
      if (radio) radio.checked = true;
      // After the smooth scroll, move focus to the form's first field so the next step is obvious.
      const first = document.querySelector<HTMLInputElement>('#register input:not([type=hidden]):not([tabindex="-1"])');
      setTimeout(() => first?.focus({ preventScroll: true }), 600);
    }),
  );

</script>
