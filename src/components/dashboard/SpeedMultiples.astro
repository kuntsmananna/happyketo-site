---
/**
 * Speed score history as small multiples: one mini line chart per page (one series each, so no colour legend and no
 * colliding end labels). 2px line, ~10% area wash, ≥ 8px dots with a 2px surface ring, 24px hit targets with
 * tooltips; y axis 50–100 with hairline grid; table view below.
 */
interface Props {
  series: { label: string; path: string; points: { date: string; value: number }[] }[];
}
const { series } = Astro.props;
const W = 260, H = 110, PAD = { l: 26, r: 10, t: 10, b: 22 };
const yMin = 50, yMax = 100;
const y = (v: number) => PAD.t + (1 - (Math.max(v, yMin) - yMin) / (yMax - yMin)) * (H - PAD.t - PAD.b);
const fmt = (d: string) => new Date(d).toLocaleDateString('he-IL', { day: 'numeric', month: 'numeric' });
---

<div class="grid gap-4 sm:grid-cols-2">
  {
    series.map((s) => {
      const n = s.points.length;
      const x = (i: number) => (n === 1 ? (PAD.l + W - PAD.r) / 2 : PAD.l + (i / (n - 1)) * (W - PAD.l - PAD.r));
      const line = s.points.map((p, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(p.value).toFixed(1)}`).join(' ');
      const area = n > 1 ? `${line} L${x(n - 1).toFixed(1)},${H - PAD.b} L${x(0).toFixed(1)},${H - PAD.b} Z` : '';
      const last = s.points.at(-1);
      return (
        <figure class="rounded-2xl border border-cream-200 p-4">
          <figcaption class="flex items-baseline justify-between gap-2">
            <a href={encodeURI(s.path)} class="font-bold text-bark-900 hover:underline">{s.label}</a>
            {last && <span class="text-2xl font-semibold text-bark-900 [font-family:system-ui]">{last.value}</span>}
          </figcaption>
          <svg viewBox={`0 0 ${W} ${H}`} class="mt-2 w-full overflow-visible [direction:ltr]" role="img" aria-label={`ציון מהירות ${s.label}: ${s.points.map((p) => `${fmt(p.date)} – ${p.value}`).join(', ')}`}>
            {[50, 75, 100].map((t) => (
              <g>
                <line x1={PAD.l} x2={W - PAD.r} y1={y(t)} y2={y(t)} stroke="var(--color-chart-grid)" stroke-width="1" />
                <text x={PAD.l - 6} y={y(t) + 4} text-anchor="end" font-size="10" fill="var(--color-bark-500)">{t}</text>
              </g>
            ))}
            {area && <path d={area} fill="var(--color-chart-1)" fill-opacity="0.1" />}
            {n > 1 && <path d={line} fill="none" stroke="var(--color-chart-1)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />}
            {s.points.map((p, i) => (
              <g tabindex="0" data-tip={`${fmt(p.date)}: ${p.value}`} class="outline-none [&:focus-visible>circle:last-child]:stroke-forest-700">
                <circle cx={x(i)} cy={y(p.value)} r="12" fill="transparent" />
                <circle cx={x(i)} cy={y(p.value)} r="4.5" fill="var(--color-chart-1)" stroke="#fff" stroke-width="2" />
              </g>
            ))}
            {n > 0 && <text x={x(0)} y={H - 4} text-anchor={n === 1 ? 'middle' : 'start'} font-size="10" fill="var(--color-bark-500)">{fmt(s.points[0].date)}</text>}
            {n > 1 && <text x={x(n - 1)} y={H - 4} text-anchor="end" font-size="10" fill="var(--color-bark-500)">{fmt(s.points[n - 1].date)}</text>}
          </svg>
        </figure>
      );
    })
  }
</div>
<details class="mt-3 text-sm">
  <summary class="inline-flex min-h-9 cursor-pointer items-center text-forest-700 underline underline-offset-4">הצגה כטבלה</summary>
  <table class="mt-2 w-full">
    <thead><tr class="border-b border-cream-200 text-bark-500"><th class="py-1 text-start font-normal">תאריך</th>{series.map((s) => <th class="py-1 text-start font-normal">{s.label}</th>)}</tr></thead>
    <tbody>
      {(series[0]?.points ?? []).map((p, i) => (
        <tr class="border-b border-cream-100"><td class="py-1 tabular-nums">{fmt(p.date)}</td>{series.map((s) => <td class="py-1 tabular-nums">{s.points[i]?.value ?? '–'}</td>)}</tr>
      ))}
    </tbody>
  </table>
</details>
