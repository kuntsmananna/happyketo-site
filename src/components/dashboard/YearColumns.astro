---
/**
 * Items published per year, stacked by type (recipes = chart-1, posts = chart-2, fixed order). Time runs left to
 * right; ≤ 24px columns, 2px surface gap between segments, 4px rounded top, total on the cap; legend + table.
 */
interface Props {
  data: { label: string; recipes: number; posts: number }[];
}
const { data } = Astro.props;
const max = Math.max(...data.map((d) => d.recipes + d.posts), 1);
const H = 160; // plot height in px
---

<figure>
  <div class="mb-3 flex gap-5 text-sm text-bark-700" aria-hidden="true">
    <span class="inline-flex items-center gap-1.5"><span class="size-3 rounded-[3px] bg-chart-1"></span>מתכונים</span>
    <span class="inline-flex items-center gap-1.5"><span class="size-3 rounded-[3px] bg-chart-2"></span>פוסטים</span>
  </div>
  <div dir="ltr" class="flex items-end justify-around gap-2 border-b border-chart-grid px-2" style={`height:${H + 28}px`} role="img" aria-label={`פריטים שפורסמו לפי שנה: ${data.map((d) => `${d.label} – ${d.recipes} מתכונים, ${d.posts} פוסטים`).join('; ')}`}>
    {
      data.map((d) => {
        const total = d.recipes + d.posts;
        return (
          <div class="flex flex-col items-center rounded-md px-2 hover:bg-cream-50 focus-visible:bg-cream-50" tabindex="0" data-tip={`${d.label}: ${d.recipes} מתכונים, ${d.posts} פוסטים`}>
            <span class="mb-1 text-sm font-bold text-bark-800 tabular-nums">{total}</span>
            <div class="flex w-6 flex-col gap-[2px]">
              {d.posts > 0 && <span class="block rounded-t-[4px] bg-chart-2" style={`height:${(d.posts / max) * H}px`} />}
              {d.recipes > 0 && <span class:list={['block bg-chart-1', d.posts === 0 && 'rounded-t-[4px]']} style={`height:${(d.recipes / max) * H}px`} />}
            </div>
          </div>
        );
      })
    }
  </div>
  <div dir="ltr" class="flex justify-around gap-2 px-2 pt-1.5 text-sm text-bark-500" aria-hidden="true">
    {data.map((d) => <span class="w-10 text-center tabular-nums">{d.label}</span>)}
  </div>
  <details class="mt-3 text-sm">
    <summary class="inline-flex min-h-9 cursor-pointer items-center text-forest-700 underline underline-offset-4">הצגה כטבלה</summary>
    <table class="mt-2 w-full">
      <thead><tr class="border-b border-cream-200 text-bark-500"><th class="py-1 text-start font-normal">שנה</th><th class="py-1 text-start font-normal">מתכונים</th><th class="py-1 text-start font-normal">פוסטים</th></tr></thead>
      <tbody>{data.map((d) => <tr class="border-b border-cream-100"><td class="py-1 tabular-nums">{d.label}</td><td class="py-1 tabular-nums">{d.recipes}</td><td class="py-1 tabular-nums">{d.posts}</td></tr>)}</tbody>
    </table>
  </details>
</figure>
