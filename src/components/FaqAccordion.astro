---
/** FAQ on navy with thin dividers and lime questions (as on the original). Exclusive accordion via <details name>. */
import Icon from './Icon.astro';
import { faqFor } from '@/data/faq';
import { homeFor } from '@/data/home';
import { getLang } from '@/i18n';

interface Props {
  title?: string;
  /** FAQPage structured data – emit on one page per language only (the homepages). */
  schema?: boolean;
}

const lang = getLang(Astro.url);
const faq = faqFor(lang);
const { title = homeFor(lang).faqTitle, schema = true } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: lang,
  mainEntity: faq.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a.join('\n') },
  })),
};
---

<section class="surface-navy section-y" aria-labelledby="faq-title">
  <div class="container-page max-w-3xl">
    <h2 id="faq-title" class="h-section mb-10 text-center text-cream-100">{title}</h2>
    <div class="border-t border-navy-300/40">
      {
        faq.map(({ q, a }) => (
          <details name="faq" class="group border-b border-navy-300/40">
            <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-4 text-lg text-lime-100 transition-colors hover:text-mustard-300 [&::-webkit-details-marker]:hidden">
              {q}
              <Icon name="chevron" size={20} class="shrink-0 text-cream-100 transition-transform duration-300 group-open:rotate-180" />
            </summary>
            <div class="space-y-3 pb-6 text-lg leading-relaxed text-cream-100/95">
              {a.map((p) => (
                <p>{p}</p>
              ))}
            </div>
          </details>
        ))
      }
    </div>
  </div>
  {schema && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</section>
