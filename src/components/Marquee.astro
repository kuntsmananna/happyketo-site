---
/**
 * The original's mustard band: "Happy Keto • Happy Keto …" / "Keto Blog • Happy Blog …" (logo font + italic serif),
 * optionally with small white sparkles, as on the original (132px tall on desktop; the Pantry band is 126px).
 * The text scrolls slowly sideways (Anna's choice; the original was static) and pauses on hover; with reduced motion it
 * stays static and centered, as on the original. Decorative (aria-hidden).
 */
import Star from './Star.astro';

interface Props {
  /** The second word, e.g. "Blog", "Recipes", "Favorites", "Keto". */
  word: string;
  tone?: 'mustard' | 'lime';
  /** Small white sparkles (the About page band has them). */
  sparkles?: boolean;
}

const { word, tone = 'mustard', sparkles: withSparkles = false } = Astro.props;
// The original's text: "Happy Keto • Happy Keto • Happy Keto • Happy Keto" / "Keto X • Happy X • Keto X".
const run = word === 'Keto' ? Array.from({ length: 4 }, () => ['Happy', 'Keto']) : [['Keto', word], ['Happy', word], ['Keto', word]];
// The ticker shows the run 6 times (two identical halves of 3), each followed by a bullet.
const ticker = Array.from({ length: 6 }, () => run).flat();
// Sparkle positions (x %, top or bottom) measured on the original band.
const sparkles = [
  { x: 25, top: true, s: 16 },
  { x: 35.5, top: true, s: 13 },
  { x: 66, top: true, s: 16 },
  { x: 49, top: false, s: 14 },
  { x: 86, top: false, s: 14 },
  { x: 8, top: false, s: 12 },
];
---

<div
  aria-hidden="true"
  class:list={[
    'relative flex h-[90px] items-center overflow-hidden text-forest-600 select-none lg:h-[132px]',
    tone === 'mustard' ? 'bg-mustard-400' : 'bg-lime-100',
  ]}
  dir="ltr"
>
  {
    withSparkles &&
    sparkles.map((sp) => (
      <Star
        size={sp.s}
        class:list={['absolute z-10 text-cream-50', sp.top ? 'top-[10%]' : 'bottom-[10%]']}
        style={`left:${sp.x}%`}
      />
    ))
  }
  <!-- Reduced motion: static and centered, as on the original. -->
  <p class="absolute left-1/2 hidden -translate-x-1/2 text-[1.75rem] leading-none whitespace-nowrap motion-reduce:block lg:text-[2.3rem]">
    {
      run.map(([a, b], i) => (
        <>
          {i > 0 && <span class="mx-2.5">•</span>}
          <span class="font-logo font-bold">{a}</span>&nbsp;<span class="font-serif italic">{b}</span>
        </>
      ))
    }
  </p>
  <!-- Ticker: two identical halves (each wider than any screen) moving left by one half per cycle, seamlessly. -->
  <div class="flex w-max animate-marquee text-[1.75rem] leading-none whitespace-nowrap hover:[animation-play-state:paused] motion-reduce:hidden lg:text-[2.3rem]">
    {
      ticker.map(([a, b]) => (
        <span class="flex shrink-0">
          <span class="font-logo font-bold">{a}</span>&nbsp;<span class="font-serif italic">{b}</span>
          <span class="mx-2.5">•</span>
        </span>
      ))
    }
  </div>
</div>
