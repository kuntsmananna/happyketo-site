---
/** Share icons under a post, as on the original: Facebook, copy link, print. */
interface Props {
  url: string;
}
const { url } = Astro.props;
---

<div class="flex items-center justify-end gap-6 border-t border-bark-300/60 pt-4 text-bark-800 print:hidden" data-share>
  <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`} target="_blank" rel="noopener" class="grid size-11 place-items-center hover:text-forest-600">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 8.5V6.6c0-.9.6-1.1 1-1.1h2.6V1.6L14 1.5c-4 0-4.9 3-4.9 4.9v2.1H6.8v4h2.3V22.5H14V12.5h3.3l.4-4Z" /></svg>
    <span class="sr-only">שיתוף בפייסבוק</span>
  </a>
  <button type="button" class="grid size-11 place-items-center hover:text-forest-600" data-copy={url}>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1" /><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" /></svg>
    <span class="sr-only" data-copy-label>העתקת קישור</span>
  </button>
  <button type="button" class="grid size-11 place-items-center hover:text-forest-600" data-print>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 9V3h10v6" /><rect x="3" y="9" width="18" height="8" rx="1" /><path d="M7 14h10v7H7z" /></svg>
    <span class="sr-only">הדפסה</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-print]').forEach((b) => b.addEventListener('click', () => print()));
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        const label = b.querySelector('[data-copy-label]');
        if (label) label.textContent = 'הקישור הועתק';
        b.classList.add('text-forest-600');
      } catch {}
    }),
  );
</script>
