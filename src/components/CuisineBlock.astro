---
/**
 * Keto Cuisine (rooftop dinners in Jaffa) as on the original.
 * Desktop: tall day photo beside a text column with the small night photo under it (original: 530 | 61 | 451 px, text on the left).
 * Phones (original mobile layout): night photo full width on top, then the text.
 */
import { Image } from 'astro:assets';
import ArrowLong from './ArrowLong.astro';
import Star from './Star.astro';
import { homeFor } from '@/data/content';
import { getLang, localized } from '@/i18n';
import day from '@/assets/home/cuisine-rooftop-day.jpg';
import night from '@/assets/home/cuisine-rooftop-night.jpg';

const lang = getLang(Astro.url);
const c = homeFor(lang).cuisine;
---

<section class="bg-cream-100 pb-12 text-forest-600 lg:pt-[116px] lg:pb-10" aria-labelledby="cuisine-title">
  <div class="lg:mx-auto lg:grid lg:w-[1042px] lg:grid-cols-[530px_451px] lg:gap-x-[61px]">
    <Image
      src={day}
      alt={c.dayAlt}
      width={917}
      height={1400}
      fit="cover"
      widths={[530, 917]}
      sizes="530px"
      data-reveal="fade"
      class="hidden aspect-[530/809] w-[530px] object-cover lg:block"
    />
    <div class="flex flex-col">
      <div class="order-2 ps-[7.5%] pe-[3%] pt-5 lg:order-1 lg:px-0 lg:pt-0">
        <p data-reveal class="eyebrow">{c.eyebrow}</p>
        <h2 data-reveal id="cuisine-title" class="h-section lg:mt-0.5">{c.title}</h2>
        <div data-reveal class="text-body mt-3">
          {c.lines.map((l) => <p>{l}</p>)}
        </div>
        <ul class="text-body mt-6 space-y-7 lg:mt-10">
          {
            c.list.map((i) => (
              <li data-reveal class="relative lg:ps-[31px]">
                <Star class="hidden lg:absolute lg:start-0 lg:top-[0.3em] lg:block" />
                {i}
              </li>
            ))
          }
          <li data-reveal class="lg:ps-[31px]">{c.note}</li>
        </ul>
        <a data-reveal href={localized('/contact', lang)} class="group mt-6 inline-flex min-h-11 items-center gap-3 text-[1.2rem] text-forest-800 transition-colors hover:text-mustard-400 lg:ms-[31px] lg:mt-8 lg:text-base">
          {c.cta}
          <ArrowLong />
        </a>
      </div>
      <Image
        src={night}
        alt={c.nightAlt}
        width={640}
        height={808}
        fit="cover"
        widths={[390, 640, 780]}
        sizes="(min-width: 1024px) 320px, 100vw"
        data-reveal
        class="order-1 aspect-[320/369] w-full object-cover lg:order-2 lg:mt-[37px] lg:aspect-[320/404] lg:w-[320px] lg:self-end"
      />
    </div>

  </div>
</section>
