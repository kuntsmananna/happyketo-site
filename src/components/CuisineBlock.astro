---
/**
 * Keto Cuisine (rooftop dinners in Jaffa) as on the original.
 * Desktop: tall day photo beside a text column with the small night photo under it (original: 530 | 61 | 451 px, text on the left).
 * Phones (original mobile layout): night photo full width on top, then the text.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { homeFor } from '@/data/home';
import { getLang, localized } from '@/i18n';
import day from '@/assets/home/cuisine-rooftop-day.jpg';
import night from '@/assets/home/cuisine-rooftop-night.jpg';

const lang = getLang(Astro.url);
const c = homeFor(lang).cuisine;
---

<section class="bg-cream-100 pb-12 text-forest-600 lg:pt-[116px] lg:pb-10" aria-labelledby="cuisine-title">
  <div class="lg:mx-auto lg:grid lg:w-[1042px] lg:grid-cols-[530px_451px] lg:gap-x-[61px]">
    <Image
      src={day}
      alt={c.dayAlt}
      width={917}
      height={1400}
      fit="cover"
      widths={[530, 917]}
      sizes="530px"
      class="hidden aspect-[530/809] w-[530px] object-cover lg:block"
    />
    <div class="flex flex-col">
      <div class="order-2 ps-[7.5%] pe-[3%] pt-5 lg:order-1 lg:px-0 lg:pt-0">
        <p class="font-serif text-[1.9rem] leading-[1.2] italic lg:text-[1.875rem]">{c.eyebrow}</p>
        <h2 id="cuisine-title" class="text-[1.75rem] leading-[1.2] lg:mt-0.5 lg:text-[2.3rem]">{c.title}</h2>
        <div class="mt-3 text-[1.2rem] leading-[1.4] lg:text-xl">
          {c.lines.map((l) => <p>{l}</p>)}
        </div>
        <ul class="mt-6 space-y-7 text-[1.2rem] leading-[1.4] lg:mt-10 lg:text-xl">
          {
            c.list.map((i) => (
              <li class="relative lg:ps-[31px]">
                <span class="hidden lg:absolute lg:start-0 lg:top-0 lg:inline" aria-hidden="true">✦</span>
                {i}
              </li>
            ))
          }
          <li class="lg:ps-[31px]">{c.note}</li>
        </ul>
        <a href={`${localized('/contact', lang)}?topic=events`} class="mt-6 inline-flex min-h-11 items-center gap-3 text-[1.2rem] text-forest-800 hover:underline lg:ms-[31px] lg:mt-8 lg:text-base">
          {c.cta}
          <Icon name="arrowLong" size={26} />
        </a>
      </div>
      <Image
        src={night}
        alt={c.nightAlt}
        width={640}
        height={808}
        fit="cover"
        widths={[390, 640, 780]}
        sizes="(min-width: 1024px) 320px, 100vw"
        class="order-1 aspect-[320/369] w-full object-cover lg:order-2 lg:mt-[37px] lg:aspect-[320/404] lg:w-[320px] lg:self-end"
      />
    </div>

  </div>
</section>
