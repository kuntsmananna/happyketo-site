---
/**
 * The recipe inside a post: "מצרכים" + ingredient lines, "אופן ההכנה" + numbered steps (headings and order as on the
 * original). Cooking aids (an addition, Anna's choice): time/servings chips, a print button, ingredients and steps
 * that can be ticked off while cooking (native checkboxes, so they work without JS; the ticks are remembered per
 * recipe on this device). Printing shows only the title and this box (see the print rules below).
 */
import Icon from './Icon.astro';
import { formatMinutes, type Recipe } from '@/lib/recipes';

interface Props {
  recipe: Recipe;
  /** Parts Claude changed that Anna hasn't approved yet: shown in purple. */
  review?: string[];
}

const { recipe, review = [] } = Astro.props;
const marked = (part: string) => review.includes(part);
const { ingredients, instructions, prepTime, cookTime, servings } = recipe.data;
const meta = [
  prepTime && { icon: 'clock', text: `זמן הכנה: ${formatMinutes(prepTime)}` },
  cookTime && { icon: 'clock', text: `זמן בישול: ${formatMinutes(cookTime)}` },
  servings && { icon: 'users', text: `כמות: ${servings}` },
].filter(Boolean) as { icon: 'clock' | 'users'; text: string }[];
let step = 0;
---

{
  (ingredients.length > 0 || instructions.length > 0) && (
    <section id="recipe" class="recipe-box not-prose" aria-label="המתכון" data-recipe-box={recipe.id}>
      <div class="flex flex-wrap items-center gap-2 print:hidden">
        {meta.map((m) => (
          <span class="inline-flex min-h-9 items-center gap-1.5 rounded-full bg-lime-100 px-3.5 text-base text-forest-700">
            <Icon name={m.icon} size={17} />
            {m.text}
          </span>
        ))}
        <button type="button" class="btn-outline btn-sm ms-auto gap-1.5 text-base" data-print>
          <Icon name="printer" size={18} />
          הדפסת המתכון
        </button>
      </div>
      {meta.length > 0 && <p class="hidden print:block">{meta.map((m) => m.text).join(' · ')}</p>}

      {ingredients.length > 0 && (
        <>
          <h2 class="recipe-h2">מצרכים{marked('ingredients') && <span class="review-tag">✎ שונה – לבדיקה</span>}</h2>
          <p class="mt-1 text-base text-bark-500 print:hidden">אפשר לסמן כל מצרך שכבר הכנתם.</p>
          {ingredients.map((group) => (
            <>
              {group.title && <h3 class="recipe-h3">{group.title}</h3>}
              <ul class:list={['mt-3 divide-y divide-bark-300/40', marked('ingredients') && 'text-review-700']}>
                {group.items.map((item) => (
                  <li>
                    <label class="recipe-check group/item flex cursor-pointer items-start gap-3.5 py-2.5">
                      <input type="checkbox" class="peer sr-only" />
                      <span
                        aria-hidden="true"
                        class="mt-[0.2em] grid size-6 shrink-0 place-items-center rounded-md border-2 border-forest-500 text-cream-50 transition-colors peer-checked:border-forest-600 peer-checked:bg-forest-600 peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-forest-700 [&>svg]:scale-0 [&>svg]:transition-transform peer-checked:[&>svg]:scale-100 print:hidden"
                      >
                        <Icon name="check" size={16} />
                      </span>
                      <span class="transition-colors peer-checked:text-bark-400 peer-checked:line-through print:before:me-2 print:before:content-['☐']">{item}</span>
                    </label>
                  </li>
                ))}
              </ul>
            </>
          ))}
        </>
      )}

      {instructions.length > 0 && (
        <>
          <h2 class="recipe-h2">אופן ההכנה{marked('instructions') && <span class="review-tag">✎ שונה – לבדיקה</span>}</h2>
          {instructions.map((group) => (
            <>
              {group.title && <h3 class="recipe-h3">{group.title}</h3>}
              <ol class:list={['mt-4 space-y-5', marked('instructions') && 'text-review-700']}>
                {group.steps.map((text) => (
                  <li>
                    <label class="recipe-check flex cursor-pointer items-start gap-4">
                      <input type="checkbox" class="peer sr-only" />
                      <span
                        aria-hidden="true"
                        class="grid size-10 shrink-0 place-items-center rounded-full bg-forest-600 font-display text-xl text-lime-100 transition-colors peer-checked:bg-lime-100 peer-checked:text-forest-600 peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-forest-700 print:size-8 print:border print:border-bark-800 print:bg-transparent print:text-base print:text-bark-800"
                      >
                        {++step}
                      </span>
                      <span class="pt-1.5 transition-colors peer-checked:text-bark-400">
                        <span class="sr-only">{`שלב ${step}: `}</span>
                        {text}
                      </span>
                    </label>
                  </li>
                ))}
              </ol>
            </>
          ))}
        </>
      )}
    </section>
  )
}

<style>
  @reference "../styles/global.css";
  .recipe-box {
    @apply text-[1.2rem] leading-[1.5] text-bark-800 lg:text-xl;
  }
  .recipe-h2 {
    @apply h-section mt-10 font-display text-forest-600;
  }
  .recipe-box > .recipe-h2:first-of-type {
    @apply mt-8;
  }
  .review-tag {
    @apply ms-3 inline-block rounded-full bg-review-50 px-3 py-1 align-middle font-sans text-sm font-bold text-review-700 ring-1 ring-review-500;
  }
  .recipe-h3 {
    @apply h-card mt-6 font-display text-forest-600;
  }

  /* Print: only the title and the recipe, in black on white. */
  @media print {
    :global(body:has(.recipe-box) main > article > :not(h1, .prose)),
    :global(body:has(.recipe-box) .prose > :not(.recipe-box)),
    :global(body:has(.recipe-box) [data-kickstart]),
    :global(body:has(.recipe-box) [data-jump]) {
      display: none !important;
    }
    .recipe-box {
      @apply text-[12pt] text-black;
    }
    .recipe-h2 {
      @apply mt-6 text-[18pt] text-black;
    }
    .recipe-box :global(span) {
      text-decoration: none !important;
      color: inherit !important;
    }
  }
</style>

<script>
  // Remember ticked ingredients/steps per recipe on this device (best effort: storage can be unavailable).
  document.querySelectorAll<HTMLElement>('[data-recipe-box]').forEach((box) => {
    const key = `hk-recipe:${box.dataset.recipeBox}`;
    const boxes = [...box.querySelectorAll<HTMLInputElement>('.recipe-check input')];
    try {
      const saved: number[] = JSON.parse(localStorage.getItem(key) ?? '[]');
      saved.forEach((i) => boxes[i] && (boxes[i].checked = true));
    } catch {}
    box.addEventListener('change', () => {
      try {
        const on = boxes.flatMap((b, i) => (b.checked ? [i] : []));
        if (on.length) localStorage.setItem(key, JSON.stringify(on));
        else localStorage.removeItem(key);
      } catch {}
    });
  });
  document.querySelectorAll<HTMLButtonElement>('.recipe-box [data-print]').forEach((b) => b.addEventListener('click', () => print()));
</script>
