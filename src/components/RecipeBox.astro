---
/**
 * The recipe inside a post, as on the original: "מצרכים" heading + bulleted lines, "אופן ההכנה" heading + numbered lines.
 * Group titles (when present) are shown above their lines. Times/servings appear only when the recipe has them.
 */
import { formatMinutes, type Recipe } from '@/lib/recipes';

interface Props {
  recipe: Recipe;
}

const { ingredients, instructions, prepTime, cookTime, servings } = Astro.props.recipe.data;
const meta = [prepTime && `זמן הכנה: ${formatMinutes(prepTime)}`, cookTime && `זמן בישול: ${formatMinutes(cookTime)}`, servings && `כמות: ${servings}`].filter(Boolean);
---

{
  (ingredients.length > 0 || instructions.length > 0) && (
    <section id="recipe" class="scroll-mt-28" aria-label="המתכון">
      {meta.length > 0 && <p>{meta.join(' · ')}</p>}
      {ingredients.length > 0 && (
        <>
          <h2>מצרכים</h2>
          {ingredients.map((group) => (
            <>
              {group.title && <h3>{group.title}</h3>}
              <ul>
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </>
          ))}
        </>
      )}
      {instructions.length > 0 && (
        <>
          <h2>אופן ההכנה</h2>
          {instructions.map((group) => (
            <>
              {group.title && <h3>{group.title}</h3>}
              <ol>
                {group.steps.map((step) => (
                  <li>{step}</li>
                ))}
              </ol>
            </>
          ))}
        </>
      )}
    </section>
  )
}
