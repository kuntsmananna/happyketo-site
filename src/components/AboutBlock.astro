---
/** Lime "about" section: centered story, green button, salmon photo + round portrait + Low Carb sticker. */
import { Image } from 'astro:assets';
import { homeFor } from '@/data/home';
import { getLang, localized } from '@/i18n';
import salmon from '@/assets/home/challenge-salmon.jpg';
import anna from '@/assets/home/anna.jpg';
import sticker from '@/assets/brand/sticker-low-carb.png';

const lang = getLang(Astro.url);
const c = homeFor(lang).about;
---

<section class="overflow-x-clip bg-lime-100 section-y" aria-labelledby="about-title">
  <div class="container-page max-w-4xl text-center">
    {
      c.heading ? (
        <h2 id="about-title" class="font-serif text-3xl italic sm:text-4xl">
          {c.heading}
        </h2>
      ) : (
        <h2 id="about-title" class="sr-only">
          {c.cta}
        </h2>
      )
    }
    <div class:list={['mx-auto max-w-3xl space-y-3 font-display text-xl leading-relaxed text-forest-600 sm:text-2xl', c.heading && 'mt-6']}>
      {c.paragraphs.map((p) => <p>{p}</p>)}
    </div>
    <a href={localized('/about', lang)} class="btn-secondary mt-8">{c.cta}</a>

    <figure class="relative mx-auto mt-14 max-w-2xl">
      <Image
        src={salmon}
        alt={c.salmonAlt}
        width={1200}
        height={760}
        fit="cover"
        widths={[480, 720, 960, 1200]}
        sizes="(min-width: 672px) 36rem, 78vw"
        class="aspect-[1200/760] w-[85%] object-cover"
      />
      <Image
        src={anna}
        alt={c.annaAlt}
        width={640}
        height={640}
        fit="cover"
        position="top"
        widths={[240, 360, 480, 640]}
        sizes="(min-width: 672px) 18rem, 39vw"
        class="absolute -bottom-10 end-0 aspect-square w-[42%] rounded-full border-4 border-lime-100 object-cover"
      />
      <Image src={sticker} alt="" width={160} class="absolute -top-8 end-[30%] w-20 rotate-[10deg] drop-shadow-md sm:w-28" />
      <figcaption class="mt-6 w-[55%] text-start text-lg text-forest-600">{c.name}</figcaption>
    </figure>
  </div>
</section>
