---
/** Filter (an addition) + the original's two-column grid of square recipe tiles. `recipes` is what to show; `all` feeds the chip counts. */
import RecipeCard from './RecipeCard.astro';
import RecipeFilter from './RecipeFilter.astro';
import { countByCategory, type Recipe } from '@/lib/recipes';

interface Props {
  recipes: Recipe[];
  all: Recipe[];
  active?: string;
}

const { recipes, all, active } = Astro.props;
---

<section class="mx-auto max-w-[1280px] px-[6%] pt-8 pb-16 lg:px-5 lg:pt-5 lg:pb-24">
  <RecipeFilter target="recipe-list" counts={countByCategory(all)} total={all.length} active={active} />
  <div id="recipe-list" class="grid gap-8 sm:grid-cols-2">
    {recipes.map((recipe, i) => <RecipeCard recipe={recipe} priority={i === 0} headingLevel={2} />)}
  </div>
  <div data-filter-empty hidden class="py-16 text-center text-lg text-bark-600">
    <p>לא נמצאו מתכונים <span aria-hidden="true">🤔</span> נסו מילה אחרת או קטגוריה אחרת.</p>
    <button type="button" class="btn-outline btn-sm mt-5" data-filter-reset>ניקוי החיפוש</button>
  </div>
</section>
