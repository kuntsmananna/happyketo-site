---
/** Recipe tile: the original's square photo tile with the first category as the chip. Keeps RecipeFilter's data-*. */
import PhotoTile from './PhotoTile.astro';
import { categoryLabel, recipeUrl, type Recipe } from '@/lib/recipes';
import sticker from '@/assets/brand/sticker-happy-keto.png';

interface Props {
  recipe: Recipe;
  /** Eager-load images of the first cards in view. */
  eager?: boolean;
  headingLevel?: 2 | 3;
}

const { recipe, eager, headingLevel } = Astro.props;
const { title, description, image, category, tags } = recipe.data;
const attrs = { 'data-recipe-card': true, 'data-categories': category.join(' '), 'data-search': `${title} ${description} ${tags.join(' ')}` };
---

<PhotoTile
  title={title}
  href={recipeUrl(recipe)}
  image={image}
  sticker={sticker}
  chip={category[0] ? categoryLabel(category[0]) : undefined}
  eager={eager}
  headingLevel={headingLevel}
  attrs={attrs}
/>
