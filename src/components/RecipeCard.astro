---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { categoryLabel, formatMinutes, recipeUrl, type Recipe } from '@/lib/recipes';
import sticker from '@/assets/brand/sticker-happy-keto.png';

interface Props {
  recipe: Recipe;
  /** Eager-load images of the first cards in view. */
  eager?: boolean;
  headingLevel?: 2 | 3;
}

const { recipe, eager = false, headingLevel = 3 } = Astro.props;
const { title, description, image, category, prepTime } = recipe.data;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<article
  class="card card-interactive group relative flex flex-col overflow-hidden [contain-intrinsic-size:auto_26rem] [content-visibility:auto]"
  data-recipe-card
  data-categories={category.join(' ')}
  data-search={`${title} ${description}`}
>
  <div class="relative aspect-[4/3] overflow-hidden bg-sage-100">
    {
      image ? (
        <Image
          src={image}
          alt=""
          width={900}
          height={675}
          fit="cover"
          widths={[360, 480, 640, 720, 900]}
          sizes="(min-width: 1280px) 22rem, (min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw"
          class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading={eager ? 'eager' : 'lazy'}
        />
      ) : (
        <div class="grid size-full place-items-center">
          <Image src={sticker} alt="" width={120} class="w-24 opacity-80" />
        </div>
      )
    }
    {
      prepTime && (
        <span class="absolute bottom-3 start-3 inline-flex items-center gap-1 rounded-full bg-white/90 px-2.5 py-1 text-xs font-medium text-cocoa-800 backdrop-blur">
          <Icon name="clock" size={14} />
          {formatMinutes(prepTime)}
        </span>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-5">
    <ul class="mb-2 flex flex-wrap gap-1.5" aria-label="קטגוריות">
      {
        category.map((c) => (
          <li class="rounded-full bg-sage-50 px-2.5 py-0.5 text-xs font-medium text-sage-700">{categoryLabel(c)}</li>
        ))
      }
    </ul>
    <Heading class="text-lg leading-snug font-bold">
      <a href={recipeUrl(recipe)} class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-none">
        {title}
      </a>
    </Heading>
    {description && description !== title && <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-cocoa-700">{description}</p>}
  </div>
  <!-- Focus ring for the whole card when the (stretched) link is focused -->
  <span aria-hidden="true" class="pointer-events-none absolute inset-0 rounded-[inherit] ring-olive-500 ring-offset-2 group-has-[a:focus-visible]:ring-2"></span>
</article>
