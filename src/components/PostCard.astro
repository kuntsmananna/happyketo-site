---
/** Blog tile: the original's square photo tile with the first tag (or "בלוג דל פחמימות") as the chip. */
import PhotoTile from './PhotoTile.astro';
import { pendingReview, postUrl, type Post } from '@/lib/recipes';
import sticker from '@/assets/brand/sticker-good-to-know.png';

interface Props {
  post: Post;
  eager?: boolean;
  priority?: boolean;
  headingLevel?: 2 | 3;
}

const { post, eager, priority, headingLevel } = Astro.props;
const { title, image, tags } = post.data;
---

<PhotoTile title={title} href={postUrl(post)} image={image} sticker={sticker} chip={tags[0] ?? 'בלוג דל פחמימות'} eager={eager} priority={priority} headingLevel={headingLevel} review={!!pendingReview(post)} />
