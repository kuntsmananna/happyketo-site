---
/** Footer as on the original: navy band, square cream card with Call / Email / Follow, privacy link and disclaimer. */
import { site } from '@/data/site';
import { getLang, localized } from '@/i18n';
import { t } from '@/i18n/ui';

const lang = getLang(Astro.url);
const s = t(lang).footer;
const ig = site.social[0];
---

<footer class="surface-navy mt-auto px-3 pt-12 pb-32 text-center sm:pb-28 lg:px-0 lg:pt-12 lg:pb-9 print:hidden">
  <div
    class="mx-auto grid max-w-[980px] gap-8 bg-cream-100 px-4 py-12 text-base leading-[1.4] text-bark-800 lg:grid-cols-3 lg:gap-0 lg:px-10 lg:pt-[47px] lg:pb-[60px]"
    dir="ltr"
  >
    <div>
      <p class="font-serif italic">{s.call}</p>
      <a href={site.contact.phoneHref} class="mt-1 inline-flex min-h-11 items-center hover:underline lg:mt-3">
        <span dir="ltr">{site.contact.phone.replace('-', '.')}</span>&nbsp;{s.phoneSuffix}
      </a>
    </div>
    <div>
      <p class="font-serif italic">{s.email}</p>
      <a href={`mailto:${site.contact.email}`} class="mt-1 inline-flex min-h-11 items-center hover:underline lg:mt-3">{site.contact.email}</a>
    </div>
    <div>
      <p class="font-serif italic">{s.follow}</p>
      <a href={ig.href} class="mt-1 inline-flex min-h-11 items-center hover:underline lg:mt-3" target="_blank" rel="noopener">{ig.handle}</a>
    </div>
  </div>

  <div class="mx-auto mt-8 max-w-[280px] space-y-2 text-[1.07rem] leading-[1.4] text-cream-100 lg:mt-[34px] lg:max-w-[256px] lg:text-base">
    <p><a href={localized('/privacy', lang)} class="underline hover:text-lime-100">{s.privacy} 🤫</a></p>
    <p>{s.disclaimer} ❤️</p>
  </div>
</footer>
