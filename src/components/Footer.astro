---
/** Footer in the original's style: navy band with a cream "Call / Email / Follow" card. */
import Icon from './Icon.astro';
import { navFor, site } from '@/data/site';
import { getLang, localized } from '@/i18n';
import { t } from '@/i18n/ui';

const lang = getLang(Astro.url);
const s = t(lang).footer;
const year = new Date().getFullYear();
const links = navFor(lang).filter((i) => i.href !== '/' && i.href !== '/en');
const ig = site.social[0];
---

<footer class="surface-navy mt-auto pb-28 sm:pb-12 print:hidden">
  <div class="container-page pt-14">
    <div class="mx-auto grid max-w-4xl gap-8 rounded-[var(--radius-card)] bg-cream-100 px-6 py-8 text-center text-forest-700 sm:grid-cols-3 sm:px-10">
      <div>
        <p class="font-serif text-xl italic" dir="ltr">{s.call}</p>
        <a href={site.contact.phoneHref} class="mt-2 inline-flex min-h-11 items-center gap-1.5 hover:underline">
          <span dir="ltr">{site.contact.phone.replace('-', '.')}</span>
          {s.phoneSuffix}
        </a>
        <a href={site.contact.whatsappHref} class="inline-flex min-h-11 items-center justify-center gap-1.5 text-sm hover:underline" target="_blank" rel="noopener">
          <Icon name="whatsapp" size={16} />
          WhatsApp
        </a>
      </div>
      <div>
        <p class="font-serif text-xl italic" dir="ltr">{s.email}</p>
        <a href={`mailto:${site.contact.email}`} class="mt-2 inline-flex min-h-11 items-center hover:underline [overflow-wrap:anywhere]">
          {site.contact.email}
        </a>
      </div>
      <div>
        <p class="font-serif text-xl italic" dir="ltr">{s.follow}</p>
        <a href={ig.href} class="mt-2 inline-flex min-h-11 items-center gap-1.5 hover:underline" target="_blank" rel="noopener">
          <Icon name="instagram" size={18} />
          <span dir="ltr">{ig.handle}</span>
        </a>
      </div>
    </div>

    <nav aria-label={s.links} class="mt-10">
      <ul class="flex flex-wrap justify-center gap-x-5 gap-y-1 text-sm text-cream-100/90">
        {
          links.map((l) => (
            <li>
              <a href={l.href} hreflang={l.hreflang} class="inline-flex min-h-11 items-center hover:text-lime-100 hover:underline">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mt-4 space-y-1 text-center text-sm text-cream-100/85">
      <p>
        <a href={localized('/privacy', lang)} class="underline hover:text-lime-100">{s.privacy}</a> 🤫
      </p>
      <p>{s.disclaimer} ❤️</p>
      <p class="pt-3 text-cream-100/70">© {year} {site.name} · {lang === 'en' ? 'Anna Kuntsman Rosenberg' : site.author}</p>
    </div>
  </div>
</footer>
