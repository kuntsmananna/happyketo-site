---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { nav, site } from '@/data/site';
import { recipeCategories } from '@/data/categories';
import logo from '@/assets/brand/sticker-happy-keto.png';

const year = new Date().getFullYear();
const pages = nav.filter((i) => !i.children && i.href !== '/');
---

<footer class="mt-auto bg-olive-900 text-cream-100">
  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.15fr_1.35fr_1fr_0.8fr]">
    <div>
      <a href="/" class="inline-flex items-center gap-3" aria-label={`${site.name} – לעמוד הבית`}>
        <Image src={logo} alt="" width={56} height={64} class="size-14 object-contain" />
        <span class="text-xl font-bold tracking-[0.12em] text-cream-50" dir="ltr">HAPPY KETO</span>
      </a>
      <p class="mt-4 max-w-xs leading-relaxed text-cream-200/90">
        תזונה קטוגנית טבעית, פשוטה וטעימה. בלי שעות במטבח ובלי ספירת קלוריות.
      </p>
    </div>

    <div>
      <h2 class="mb-4 text-base font-medium text-cream-50">צרו קשר</h2>
      <ul class="space-y-3">
        <li>
          <a href={site.contact.phoneHref} class="inline-flex items-center gap-2.5 hover:text-white hover:underline">
            <Icon name="phone" size={18} class="text-olive-300" />
            <span dir="ltr">{site.contact.phone}</span> – אנה
          </a>
        </li>
        <li>
          <a href={site.contact.whatsappHref} class="inline-flex items-center gap-2.5 hover:text-white hover:underline" rel="noopener" target="_blank">
            <Icon name="whatsapp" size={18} class="text-olive-300" />
            וואטסאפ
          </a>
        </li>
        <li>
          <a href={`mailto:${site.contact.email}`} class="inline-flex items-center gap-2.5 hover:text-white hover:underline [overflow-wrap:anywhere]">
            <Icon name="mail" size={18} class="text-olive-300" />
            {site.contact.email}
          </a>
        </li>
        {
          site.social.map((s) => (
            <li>
              <a href={s.href} class="inline-flex items-center gap-2.5 hover:text-white hover:underline" rel="noopener" target="_blank">
                <Icon name="instagram" size={18} class="text-olive-300" />
                <span dir="ltr">{s.handle}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="mb-4 text-base font-medium text-cream-50">מתכונים</h2>
      <ul class="grid grid-cols-2 gap-x-4 gap-y-2 text-cream-200/90">
        {
          recipeCategories.map((c) => (
            <li>
              <a href={`/recipes/category/${c.slug}`} class="hover:text-white hover:underline">
                {c.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="mb-4 text-base font-medium text-cream-50">Happy Keto</h2>
      <ul class="space-y-2 text-cream-200/90">
        {
          pages.map((p) => (
            <li>
              <a href={p.href} class="hover:text-white hover:underline">
                {p.label}
              </a>
            </li>
          ))
        }
        <li><a href="/privacy" class="hover:text-white hover:underline">מדיניות פרטיות</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page flex flex-col gap-2 py-5 text-sm text-cream-200/75 sm:flex-row sm:items-center sm:justify-between">
      <p>{site.healthDisclaimer} ❤️</p>
      <p>© {year} {site.name} · {site.author}</p>
    </div>
  </div>
</footer>
