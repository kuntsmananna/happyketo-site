---
import JsonLd from './JsonLd.astro';

interface Props {
  /** Trail without the home page; the last item is the current page (href optional). */
  items: { label: string; href?: string }[];
}

const trail = [{ label: 'עמוד הבית', href: '/' }, ...Astro.props.items];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, Astro.site).href } : {}),
  })),
};
---

<nav aria-label="פירורי לחם" class="text-sm text-cocoa-600">
  <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
    {
      trail.map((item, i) => (
        <li class="flex items-center gap-1.5">
          {i > 0 && <span aria-hidden="true" class="text-cocoa-400">‹</span>}
          {item.href && i < trail.length - 1 ? (
            <a href={item.href} class="hover:text-olive-700 hover:underline">
              {item.label}
            </a>
          ) : (
            <span aria-current="page" class="text-cocoa-800">
              {item.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
<JsonLd data={jsonLd} />
