---
/**
 * Inner-page header for Recipes, Blog and the recipe categories: the original's mustard "Keto Recipes • Happy Recipes"
 * band, then a visible Hebrew title and intro (an addition, Anna's choice: the band is English and decorative).
 */
import Marquee from './Marquee.astro';

interface Props {
  title: string;
  intro?: string;
  /** Second word of the band ("Blog", "Recipes", "Desserts"…). */
  marquee: string;
}

const { title, intro, marquee } = Astro.props;
---

<Marquee word={marquee} />
<header class="mx-auto w-[88%] pt-10 text-center lg:w-[760px] lg:pt-14">
  <h1 data-reveal class="h-section">{title}</h1>
  {intro && <p data-reveal class="mt-3 text-[1.2rem] leading-[1.5] text-bark-700 lg:text-xl">{intro}</p>}
</header>
