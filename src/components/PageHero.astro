---
/** Standard inner-page header: optional breadcrumbs, Latin eyebrow, title and intro. */
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  title: string;
  eyebrow?: string;
  intro?: string;
  breadcrumbs?: { label: string; href?: string }[];
  tone?: 'sage' | 'cream';
}

const { title, eyebrow, intro, breadcrumbs, tone = 'sage' } = Astro.props;
---

<section class:list={['relative overflow-hidden', tone === 'sage' ? 'bg-sage-50' : 'bg-cream-100']}>
  <div aria-hidden="true" class="pointer-events-none absolute -end-24 -top-24 size-72 rounded-full bg-olive-100/50 blur-3xl"></div>
  <div class="container-page relative section-y-sm">
    {breadcrumbs && <div class="mb-6"><Breadcrumbs items={breadcrumbs} /></div>}
    {eyebrow && <p class="eyebrow"><span dir="ltr">{eyebrow}</span></p>}
    <h1 class="h-display max-w-3xl">{title}</h1>
    {intro && <p class="lead mt-4 max-w-2xl">{intro}</p>}
    <slot />
  </div>
</section>
