---
/**
 * The original's square photo tile (recipes, blog): photo, darkened bottom, tag chip and bold title over the photo.
 * The whole tile is one link (the title's ::after covers it; the layers are grid-stacked, not positioned, so the
 * link's containing block is the tile — so never put a transform/translate on the text block: it would shrink the link).
 * Eager (first-row) tiles skip the scroll reveal so the LCP photo paints at once. Used by RecipeCard and PostCard.
 */
import { Image } from 'astro:assets';

interface Props {
  title: string;
  href: string;
  image?: ImageMetadata;
  /** Brand sticker shown when there is no photo. */
  sticker: ImageMetadata;
  chip?: string;
  eager?: boolean;
  headingLevel?: 2 | 3;
  /** Extra attributes for the <article> (e.g. data-* used by RecipeFilter). */
  attrs?: Record<string, string | boolean>;
}

const { title, href, image, sticker, chip, eager = false, headingLevel = 3, attrs = {} } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<article
  data-reveal={eager ? undefined : true}
  class="group relative grid aspect-square grid-cols-1 grid-rows-1 overflow-hidden bg-forest-800 [contain-intrinsic-size:auto_37rem] [content-visibility:auto]"
  {...attrs}
>
  {
    image ? (
      <Image
        src={image}
        alt=""
        width={1208}
        height={1208}
        fit="cover"
        widths={[360, 600, 900, 1208]}
        sizes="(min-width: 1280px) 604px, (min-width: 640px) 46vw, 88vw"
        class="hover-zoom size-full min-h-0 min-w-0 object-cover [grid-area:1/1]"
        loading={eager ? 'eager' : 'lazy'}
      />
    ) : (
      <div class="grid place-items-center bg-mint-100 [grid-area:1/1]">
        <Image src={sticker} alt="" width={160} class="w-32 opacity-80" />
      </div>
    )
  }
  <div
    aria-hidden="true"
    class="z-[1] bg-gradient-to-t from-black/65 via-black/20 to-black/5 transition-opacity duration-500 [grid-area:1/1] group-hover:opacity-90"
  >
  </div>
  <div class="z-[2] flex flex-col items-start self-end px-6 pb-6 [grid-area:1/1] lg:pb-[27px]">
    {chip && <span class="mb-3 bg-forest-600 px-3 py-1.5 text-sm leading-none text-lime-100">{chip}</span>}
    <Heading class="font-sans text-[1.4rem] leading-tight font-bold text-cream-100 lg:text-[1.625rem]">
      <a href={href} class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-none">{title}</a>
    </Heading>
  </div>
  <span aria-hidden="true" class="pointer-events-none absolute inset-0 z-[3] ring-mustard-400 ring-inset group-has-[a:focus-visible]:ring-4"></span>
</article>
