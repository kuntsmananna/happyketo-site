---
/**
 * The original's square photo tile (recipes, blog): photo, darkened bottom, tag chip and bold title over the photo.
 * The whole tile is one link (the title's ::after covers it; the layers are grid-stacked, not positioned, so the
 * link's containing block is the tile — so never put a transform/translate on the text block: it would shrink the link).
 * Eager (first-row) tiles skip the scroll reveal so the LCP photo paints at once. Used by RecipeCard and PostCard.
 */
import { Image } from 'astro:assets';

interface Props {
  title: string;
  href: string;
  image?: ImageMetadata;
  /** Brand sticker shown when there is no photo. */
  sticker: ImageMetadata;
  chip?: string;
  eager?: boolean;
  /** The first tile on a page: fetched with high priority (it is the page's largest image). */
  priority?: boolean;
  headingLevel?: 2 | 3;
  /** Extra attributes for the <article> (e.g. data-* used by RecipeFilter). */
  attrs?: Record<string, string | boolean>;
  /** Smaller tile (homepage row): smaller title, image sizes for ~300px. */
  compact?: boolean;
  /** Claude changed this entry and Anna hasn't approved it yet: purple tag (temporary review aid). */
  review?: boolean;
}

const { title, href, image, sticker, chip, eager = false, priority = false, headingLevel = 3, attrs = {}, compact = false, review = false } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<article
  data-reveal={eager || priority ? undefined : true}
  class:list={[
    'group relative grid aspect-square grid-cols-1 grid-rows-1 overflow-hidden bg-forest-800',
    !compact && '[contain-intrinsic-size:auto_37rem] [content-visibility:auto]',
  ]}
  {...attrs}
>
  {
    image ? (
      <Image
        src={image}
        alt=""
        width={1208}
        height={1208}
        fit="cover"
        quality={70}
        widths={compact ? [300, 450, 600] : [360, 600, 900, 1208]}
        sizes={compact ? '(min-width: 1024px) 280px, 78vw' : '(min-width: 1280px) 604px, (min-width: 640px) 46vw, 88vw'}
        class="hover-zoom size-full min-h-0 min-w-0 object-cover [grid-area:1/1]"
        loading={eager || priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : compact ? 'low' : undefined}
      />
    ) : (
      <div class="grid place-items-center bg-mint-100 [grid-area:1/1]">
        <Image src={sticker} alt="" width={160} class="w-32 opacity-80" />
      </div>
    )
  }
  <div
    aria-hidden="true"
    class="z-[1] bg-gradient-to-t from-black/65 via-black/20 to-black/5 transition-opacity duration-500 [grid-area:1/1] group-hover:opacity-90"
  >
  </div>
  <div class:list={['z-[2] flex flex-col items-start self-end [grid-area:1/1]', compact ? 'px-5 pb-5' : 'px-6 pb-6 lg:pb-[27px]']}>
    {chip && <span class="mb-3 bg-forest-600 px-3 py-1.5 text-sm leading-none text-lime-100">{chip}</span>}
    <Heading class:list={['font-sans leading-tight font-bold text-cream-100', compact ? 'text-[1.3rem]' : 'text-[1.4rem] lg:text-[1.625rem]']}>
      <a href={href} class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-none">{title}</a>
    </Heading>
  </div>
  {review && <span class="pointer-events-none absolute start-3 top-3 z-[3] rounded-full bg-review-700 px-3 py-1 text-sm font-bold text-white">✎ לבדיקה</span>}
  <span aria-hidden="true" class="pointer-events-none absolute inset-0 z-[3] ring-mustard-400 ring-inset group-has-[a:focus-visible]:ring-4"></span>
</article>
