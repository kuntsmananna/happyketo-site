---
/**
 * Form posting to Web3Forms. Works without JS (POST + redirect to /thanks);
 * with JS it submits via fetch and shows the result inline.
 * Put the fields in the default slot; give the submit button type="submit".
 */
import { forms, site } from '@/data/site';
import { getLang, localized } from '@/i18n';
import { t } from '@/i18n/ui';
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'form'>, 'action' | 'method'> {
  /** Email subject — lets Anna tell the forms apart in her inbox. */
  subject: string;
  successMessage?: string;
}

const lang = getLang(Astro.url);
const s = t(lang).form;
const { subject, successMessage = s.success, class: className, ...rest } = Astro.props;
---

<form
  action={forms.endpoint}
  method="POST"
  class:list={['relative', className]}
  data-web3form
  data-success={successMessage}
  data-sending={s.sending}
  data-error={s.error}
  data-invalid={JSON.stringify(s.invalid)}
  {...rest}
>
  <input type="hidden" name="access_key" value={forms.accessKey} />
  <input type="hidden" name="subject" value={subject} />
  <input type="hidden" name="from_name" value={s.fromName} />
  <input type="hidden" name="redirect" value={`${site.url}${localized('/thanks', lang)}`} />
  <!-- Honeypot: real people never see or tick this. -->
  <input type="checkbox" name="botcheck" class="hidden" style="display: none" tabindex="-1" autocomplete="off" />
  <slot />
  <p data-form-status role="status" aria-live="polite" class="mt-3 hidden rounded-xl px-4 py-3 text-sm font-medium"></p>
</form>

<script>
  const STATUS = {
    success: 'block bg-mint-100 text-mint-700',
    error: 'block bg-red-50 text-red-800',
  };

  document.querySelectorAll<HTMLFormElement>('form[data-web3form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-form-status]')!;

    // Inline field errors: with JS the form takes over validation (noValidate) and shows a message under each
    // invalid field, linked with aria-describedby; without JS the browser's own validation still applies.
    const msgs = JSON.parse(form.dataset.invalid || '{}') as Record<string, string>;
    form.noValidate = true;
    const fields = () => [...form.querySelectorAll<HTMLInputElement>('input:not([type=hidden]):not([name=botcheck]), select, textarea')];
    const messageFor = (f: HTMLInputElement) => {
      const v = f.validity;
      if (f.type === 'radio') return msgs.choice;
      if (f.type === 'checkbox') return msgs.consent;
      if (v.valueMissing) return msgs.required;
      if (f.type === 'email') return msgs.email;
      if (f.type === 'tel') return msgs.phone;
      return f.validationMessage;
    };
    const anchorOf = (f: HTMLInputElement) => (f.type === 'radio' ? f.closest('fieldset') : f.type === 'checkbox' ? f.closest('label') : f) as HTMLElement;
    const showError = (f: HTMLInputElement, on: boolean) => {
      const group = f.type === 'radio' ? [...form.querySelectorAll<HTMLInputElement>(`input[type=radio][name="${CSS.escape(f.name)}"]`)] : [f];
      const id = `${(f.id || f.name).replace(/\W+/g, '-')}-error`;
      let el = form.querySelector<HTMLElement>(`[data-error-for="${CSS.escape(id)}"]`);
      if (!on) {
        el?.remove();
        group.forEach((g) => { g.removeAttribute('aria-invalid'); g.removeAttribute('aria-describedby'); });
        return;
      }
      if (!el) {
        el = document.createElement('p');
        el.id = id;
        el.dataset.errorFor = id;
        el.className = 'mt-1.5 text-sm font-medium text-red-700';
        anchorOf(f).insertAdjacentElement('afterend', el);
      }
      el.textContent = messageFor(f);
      group.forEach((g) => { g.setAttribute('aria-invalid', 'true'); g.setAttribute('aria-describedby', id); });
    };
    let tried = false;
    const validate = (focusFirst = false) => {
      tried = true;
      let first: HTMLInputElement | undefined;
      for (const f of fields()) {
        const ok = f.checkValidity();
        showError(f, !ok);
        if (!ok && !first) first = f;
      }
      if (first && focusFirst) first.focus();
      return !first;
    };
    // After the first attempt, errors update as the person fixes each field.
    form.addEventListener('input', (e) => { if (tried) { const f = e.target as HTMLInputElement; showError(f, !f.checkValidity()); } });
    form.addEventListener('change', (e) => { if (tried) { const f = e.target as HTMLInputElement; showError(f, !f.checkValidity()); } });
    const show = (kind: keyof typeof STATUS, text: string) => {
      status.className = `mt-4 rounded-xl px-4 py-3 text-base font-medium ${STATUS[kind]}`;
      status.textContent = text;
      // Keep the result in view (long forms: the person may be scrolled to the bottom).
      status.scrollIntoView({ block: 'nearest', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!validate(true)) return;
      const button = form.querySelector<HTMLButtonElement>('[type="submit"]');
      const label = button?.innerHTML;
      if (button) {
        button.disabled = true;
        button.textContent = form.dataset.sending!;
      }

      const data = Object.fromEntries(new FormData(form));
      delete data.redirect;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
          signal: AbortSignal.timeout(15000),
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || !json.success) throw new Error(json.message || res.statusText);
        form.reset();
        show('success', form.dataset.success!);
      } catch (err) {
        console.warn('Form submission failed:', err);
        show('error', form.dataset.error!);
      } finally {
        if (button) {
          button.disabled = false;
          button.innerHTML = label ?? '';
        }
      }
    });
  });
</script>
