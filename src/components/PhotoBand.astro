---
/** Full-width photo band with a dimmed overlay and the "I'm not dieting…" statement (as on the original). */
import { Image } from 'astro:assets';
import { homeFor } from '@/data/home';
import { getLang } from '@/i18n';
import band from '@/assets/home/challenge-lettuce-tacos.jpg';

const lang = getLang(Astro.url);
const c = homeFor(lang).band;
---

<section class="relative isolate grid h-[204px] place-items-center overflow-hidden lg:h-[403px]" aria-label={c.title.replace('\n', ' ')}>
  <Image
    src={band}
    alt=""
    width={1600}
    height={1000}
    fit="cover"
    widths={[640, 960, 1280, 1600]}
    sizes="100vw"
    class="absolute inset-0 -z-10 size-full object-cover"
  />
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-navy-900/55"></div>
  <p
    data-reveal
    class:list={[
      'mx-auto px-4 text-center text-[1.9rem] leading-[1.2] text-cream-100 lg:text-[2.625rem]',
      lang === 'en' ? 'font-serif italic' : 'font-display',
    ]}
  >
    {c.title.split('\n').map((line) => <span class="block lg:whitespace-nowrap">{line}</span>)}
  </p>
</section>
