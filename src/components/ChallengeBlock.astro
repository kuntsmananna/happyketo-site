---
/** "Going Keto" section: navy with leaf shadows, italic eyebrow, mustard title and button (as on the original). */
import Perks from './Perks.astro';
import { homeFor } from '@/data/home';
import { getLang, localized } from '@/i18n';

const lang = getLang(Astro.url);
const c = homeFor(lang).challenge;
---

<section class="surface-navy section-y" aria-labelledby="challenge-title">
  <div class="container-page max-w-3xl text-center">
    <p class="eyebrow text-cream-100"><span dir="ltr">{c.eyebrow}</span></p>
    <h2 id="challenge-title" class="text-2xl text-mustard-400 sm:text-3xl">{c.title}</h2>
    <div class="mx-auto mt-6 max-w-2xl space-y-4 text-lg leading-relaxed text-cream-100 sm:text-xl">
      {c.paragraphs.map((p) => <p>{p}</p>)}
    </div>
    <Perks tone="dark" class="mt-8" />
    <a href={localized('/challenge', lang)} class="btn-primary mt-10 px-8">{c.cta}</a>
  </div>
</section>
