---
/**
 * Purple box on a recipe/post that Claude changed and Anna hasn't approved yet: what changed, a link to the original
 * Wix post to compare, and how to approve. Visible parts are marked purple on the page; for the invisible ones
 * (Google description, photo alt texts) the box shows their current text. Temporary review aid before launch.
 * Only shown in review mode (`reviewer-only`, see /review): visitors never see it.
 */
import LinkifiedText from './LinkifiedText.astro';
import { invisibleReviewTexts, reviewSplit, type Post, type Recipe } from '@/lib/recipes';

interface Props {
  entry: Recipe | Post;
}
const { entry } = Astro.props;
const { review, visible } = reviewSplit(entry)!;
const hint: Record<string, string> = { description: 'מתחת לכותרת בתוצאות החיפוש', imageAlt: 'לקוראי מסך ולחיפוש תמונות' };
---

<aside class="reviewer-only mt-5 rounded-2xl border-2 border-review-500 bg-review-50 px-5 py-4 text-base leading-relaxed text-review-700 print:hidden" aria-label="שינוי לבדיקה">
  <p class="font-bold">✎ שינוי של Claude – לבדיקה</p>
  {review.note && <p class="mt-1 whitespace-pre-line"><LinkifiedText text={review.note} /></p>}
  {
    invisibleReviewTexts(entry).map(({ part, label, texts }) =>
      texts.length > 1 ? (
        <div class="mt-1">
          <b>{label}:</b>
          <ul class="list-disc ps-5">{texts.map((t) => <li>{t}</li>)}</ul>
        </div>
      ) : (
        <p class="mt-1">
          <b>{label}</b>
          {hint[part] && ` (${hint[part]})`}: {texts[0]}
        </p>
      ),
    )
  }
  <p class="mt-2 text-sm">
    {
      entry.data.wixUrl && (
        <>
          <a href={entry.data.wixUrl} target="_blank" rel="noopener" class="font-semibold underline">לפוסט המקורי ב-Wix להשוואה</a>
          {' · '}
        </>
      )
    }
    {visible.length > 0 ? 'החלקים שהשתנו בעמוד מסומנים בסגול. ' : 'השינוי לא נראה בעמוד עצמו – הוא מופיע בתוצאות גוגל ובקוראי מסך. '}
    כשמאשרים: בפאנל הניהול ← "שינוי לבדיקה" ← לסמן "אישרתי". <a href="/review" class="underline">כל השינויים לבדיקה</a>
  </p>
</aside>
