---
/** The three Happy Keto promises as wrapping pills (one source for homepage + challenge page). */
import Icon from './Icon.astro';

interface Props {
  class?: string;
  align?: 'start' | 'center';
}

const { class: className, align = 'start' } = Astro.props;
const perks = ['קיטו צעד אחרי צעד', 'מתאים לחיים האמיתיים', 'לא סופרים קלוריות'];
---

<ul class:list={['flex flex-wrap gap-2.5', align === 'center' && 'justify-center', className]}>
  {
    perks.map((p) => (
      <li class="inline-flex items-center gap-2 rounded-full bg-sage-50 py-2 ps-2 pe-4 font-medium text-olive-800 ring-1 ring-sage-100">
        <span class="grid size-6 place-items-center rounded-full bg-olive-600 text-cream-50">
          <Icon name="check" size={14} />
        </span>
        {p}
      </li>
    ))
  }
</ul>
