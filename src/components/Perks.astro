---
/** The three Happy Keto promises with ✔ marks (homepage + challenge page). */
import Icon from './Icon.astro';
import { homeFor } from '@/data/home';
import { getLang } from '@/i18n';

interface Props {
  class?: string;
  /** "dark": light text for navy sections (as on the original); "light": pills on light backgrounds. */
  tone?: 'dark' | 'light';
}

const { class: className, tone = 'light' } = Astro.props;
const perks = homeFor(getLang(Astro.url)).challenge.perks;
---

<ul class:list={['flex flex-wrap justify-center gap-x-6 gap-y-2.5', className]}>
  {
    perks.map((p) => (
      <li
        class:list={[
          'inline-flex items-center gap-2 font-medium',
          tone === 'dark' ? 'text-cream-100' : 'rounded-full bg-white py-2 ps-2 pe-4 text-forest-700 ring-1 ring-mint-200',
        ]}
      >
        <span
          class:list={[
            'grid size-6 place-items-center rounded-full',
            tone === 'dark' ? 'bg-mustard-400 text-navy-800' : 'bg-forest-600 text-lime-100',
          ]}
        >
          <Icon name="check" size={14} />
        </span>
        {p}
      </li>
    ))
  }
</ul>
