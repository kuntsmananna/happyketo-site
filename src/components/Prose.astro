---
/** Typography for migrated Markdown (recipes and blog posts). */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div
  class:list={[
    'prose prose-lg max-w-none text-bark-800',
    'prose-headings:font-display prose-headings:font-normal prose-headings:text-forest-600 prose-h2:mt-10 prose-h3:mt-8',
    'prose-a:text-forest-700 prose-a:underline-offset-4 hover:prose-a:text-forest-900',
    'prose-strong:text-bark-900 prose-li:marker:text-forest-500 prose-hr:border-bark-300/50',
    'prose-img:mx-auto prose-img:max-h-[80vh] prose-img:w-auto prose-img:rounded-[var(--radius-card)] prose-img:shadow-[var(--shadow-card)]',
    '[&_video]:mx-auto [&_video]:max-h-[80vh] [&_video]:rounded-[var(--radius-card)] [&_video]:shadow-[var(--shadow-card)]',
    '[&_iframe]:my-8 [&_iframe]:aspect-video [&_iframe]:h-auto [&_iframe]:w-full [&_iframe]:rounded-[var(--radius-card)]',
    className,
  ]}
>
  <slot />
</div>
