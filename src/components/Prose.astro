---
/**
 * Typography for migrated posts, as on the original blog: 20px/30px text, 37px display headings in green,
 * plain bullets and numbers, full-width images (phones: 1.2rem text, 2rem headings).
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div
  class:list={[
    'max-w-none text-[1.2rem] leading-[1.5] text-bark-800 lg:text-xl',
    '[&_p]:my-0 [&_p+p]:mt-0 [&_p:empty]:h-[1.5em]',
    '[&_h2]:mt-0 [&_h2]:font-display [&_h2]:text-[2rem] [&_h2]:leading-[1.2] [&_h2]:font-normal [&_h2]:text-forest-600 lg:[&_h2]:text-[2.3rem]',
    '[&_h3]:mt-6 [&_h3]:font-display [&_h3]:text-[2rem] [&_h3]:leading-[1.2] [&_h3]:font-normal [&_h3]:text-forest-600 lg:[&_h3]:text-[2.3rem]',
    '[&_h4]:mt-4 [&_h4]:font-display [&_h4]:text-2xl [&_h4]:font-normal [&_h4]:text-forest-600',
    '[&_ul]:my-0 [&_ul]:list-disc [&_ul]:ps-10 [&_ol]:my-0 [&_ol]:list-decimal [&_ol]:ps-10 [&_li]:ps-1',
    '[&_a]:text-forest-700 [&_a]:underline [&_a]:underline-offset-4 [&_strong]:font-bold',
    '[&_img]:my-8 [&_img]:h-auto [&_img]:w-full [&_video]:my-8 [&_video]:w-full',
    '[&_iframe]:my-8 [&_iframe]:aspect-video [&_iframe]:h-auto [&_iframe]:w-full',
    '[&_section+*]:mt-[1.5em] [&_*+h2]:mt-10 [&_*+h3]:mt-10',
    className,
  ]}
>
  <slot />
</div>
