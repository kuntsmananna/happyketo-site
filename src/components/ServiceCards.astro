---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import rooftopDay from '@/assets/home/cuisine-rooftop-day.jpg';
import rooftopNight from '@/assets/home/cuisine-rooftop-night.jpg';
import shake from '@/assets/home/recipes-green-shake.jpg';
import eggs from '@/assets/home/blog-eggs.jpg';
import allulose from '@/assets/home/favorites-allulose.jpg';
import goodToKnow from '@/assets/brand/sticker-good-to-know.png';

const events = ['ארועים לחברות וארגונים', 'חגיגות משפחתיות וימי הולדת', 'מסיבות רווקות'];

const cards = [
  {
    eyebrow: 'Tasty Keto',
    title: 'מתכונים דלי פחמימות',
    text: 'שעושים שמח לגוף ולנשמה. אם אתם מודאגים שלא יהיה לכם מה לאכול, הסירו דאגה מליבכם!',
    cta: 'בואו נכין משהו טעים',
    href: '/recipes',
    image: shake,
    alt: 'סחיטת לימון לתוך שייק ירוק',
  },
  {
    eyebrow: 'Keto Blog',
    title: 'מידע בנושא תזונה דלת פחמימות',
    text: 'כל מה שחשוב לדעת לתהליך מוצלח במעבר לתזונה טבעית קטוגנית.',
    cta: 'להמשך קריאה',
    href: '/blog',
    image: eggs,
    alt: 'ביצי עין על טוסט עם ירוקים',
    sticker: goodToKnow,
  },
  {
    eyebrow: 'Happy Favorites',
    title: 'המזווה הקטוגני',
    text: 'ניסיתי, אהבתי, ממליצה בחום!',
    cta: 'מעניין מה יש שם',
    href: '/favorites',
    image: allulose,
    alt: 'שקית ממתיק אלולוז',
    contain: true,
  },
];
---

<section class="section-y" aria-labelledby="services-title">
  <div class="container-page">
    <div class="mx-auto mb-12 max-w-2xl text-center">
      <h2 id="services-title" class="h-section">מה מחכה לכם ב-Happy Keto</h2>
      <p class="mt-4 text-lg text-cocoa-700">אוכל טבעי, מתכונים, ידע וכל מה שצריך כדי שקיטו ירגיש כמו הבית.</p>
    </div>

    <!-- Keto Cuisine: featured -->
    <article class="card mb-8 grid overflow-hidden lg:grid-cols-2">
      <div class="grid grid-cols-2 gap-1">
        <Image
          src={rooftopDay}
          alt="ארוחת טעימות על גג ביפו בשעות היום"
          widths={[240, 360, 480, 720]}
          sizes="(min-width: 1024px) 18rem, 50vw"
          class="aspect-[3/4] size-full object-cover lg:aspect-auto"
        />
        <Image
          src={rooftopNight}
          alt="שולחן ארוך עם נרות על הגג בערב"
          widths={[240, 360, 480, 720]}
          sizes="(min-width: 1024px) 18rem, 50vw"
          class="aspect-[3/4] size-full object-cover lg:aspect-auto"
        />
      </div>
      <div class="flex flex-col justify-center p-7 sm:p-10">
        <p class="eyebrow"><span dir="ltr">Keto Cuisine</span></p>
        <h3 class="text-2xl leading-snug sm:text-3xl">ארוחה על הגג הכי יפה ביפו</h3>
        <p class="mt-3 text-lg text-cocoa-700">❤️ ארוחת טעימות ממטבח קטן ואהבה גדולה.</p>
        <p class="mt-1 text-cocoa-700">אוכל טבעי ומקומי, ללא סוכר, ללא קמח ודגנים.</p>
        <ul class="mt-5 space-y-2">
          {
            events.map((e) => (
              <li class="flex items-center gap-2 text-cocoa-800">
                <Icon name="check" size={18} class="text-olive-600" />
                {e}
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-sm text-cocoa-600">התפריט יותאם באופן אישי לאופי הארוע (לקבוצות מעל 10 אנשים).</p>
        <a href="/contact?topic=events" class="btn-primary mt-6 self-start">
          לפרטים, צרו קשר
          <Icon name="arrow" size={18} />
        </a>
      </div>
    </article>

    <div class="grid gap-6 lg:grid-cols-3 lg:gap-8">
      {
        cards.map((c) => (
          <article class="card card-interactive group relative flex flex-col overflow-hidden sm:flex-row lg:flex-col">
            <div class:list={['relative shrink-0 overflow-hidden sm:w-2/5 lg:w-auto', c.contain ? 'bg-white' : 'bg-sage-100']}>
              <Image
                src={c.image}
                alt={c.alt}
                width={720}
                height={540}
                fit={c.contain ? 'contain' : 'cover'}
                widths={[360, 540, 720]}
                sizes="(min-width: 1024px) 30vw, (min-width: 640px) 38vw, 92vw"
                class:list={[
                  'aspect-[4/3] w-full transition-transform duration-500 group-hover:scale-105 sm:h-full lg:h-auto',
                  c.contain ? 'object-contain p-6' : 'object-cover',
                ]}
              />
              {c.sticker && (
                <Image src={c.sticker} alt="" width={140} class="absolute bottom-3 end-3 w-24 drop-shadow-md" />
              )}
            </div>
            <div class="flex flex-1 flex-col justify-center p-6 lg:justify-start">
              <p class="eyebrow"><span dir="ltr">{c.eyebrow}</span></p>
              <h3 class="h-card">{c.title}</h3>
              <p class="mt-2 flex-1 text-cocoa-700">{c.text}</p>
              <a
                href={c.href}
                class="mt-5 inline-flex items-center gap-1.5 font-medium text-olive-700 after:absolute after:inset-0 hover:text-olive-900"
              >
                {c.cta}
                <Icon name="arrow" size={18} class="transition-transform group-hover:-translate-x-1" />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
