---
/**
 * Tasty Keto / Keto Blog / Happy Favorites as on the original: navy section, three 325px square photos,
 * italic eyebrow, cream title and text, cream long-arrow link; Good2Know sticker at the section's lower corner.
 */
import { Image } from 'astro:assets';
import ArrowLong from './ArrowLong.astro';
import { homeFor } from '@/data/content';
import { getLang } from '@/i18n';
import allulose from '@/assets/home/favorites-allulose.jpg';
import tomatoes from '@/assets/home/blog-tomatoes.jpg';
import eggs from '@/assets/home/blog-eggs.jpg';
import goodToKnow from '@/assets/brand/sticker-good-to-know.png';

const lang = getLang(Astro.url);
const items = homeFor(lang).services;
const images = { favorites: allulose, blog: tomatoes, recipes: eggs } as const;
---

<section class="surface-navy relative overflow-x-clip pt-8 pb-16 text-cream-100 lg:pt-[106px] lg:pb-[100px]" aria-label="Happy Keto">
  <div class="mx-auto grid w-[84%] gap-16 lg:w-[1188px] lg:grid-cols-3 lg:gap-[94px]">
    {
      items.map((c) => (
        <article data-reveal class="group relative flex flex-col">
          <div class:list={['overflow-hidden', c.key === 'favorites' ? 'bg-white' : 'bg-navy-800']}>
            <Image
              src={images[c.key as keyof typeof images]}
              alt={c.alt}
              width={650}
              height={650}
              fit={c.key === 'favorites' ? 'contain' : 'cover'}
              widths={[330, 480, 650]}
              sizes="(min-width: 1024px) 325px, 84vw"
              class:list={['hover-zoom aspect-square w-full lg:w-[325px]', c.key === 'favorites' ? 'object-contain p-3' : 'object-cover']}
            />
          </div>
          <p class="eyebrow mt-9 lg:mt-[51px]">{c.eyebrow}</p>
          <h2 class="h-section mt-2 text-cream-100 lg:mt-4">{c.title}</h2>
          <p class="text-body mt-3 lg:mt-5">{c.text}</p>
          <a
            href={c.href}
            hreflang={lang === 'en' && !c.href.startsWith('/en') ? 'he' : undefined}
            class="mt-2 inline-flex min-h-11 items-center gap-3 self-start text-[1.2rem] transition-colors group-hover:text-mustard-400 after:absolute after:inset-0 lg:mt-3 lg:text-base"
          >
            {c.cta}
            <ArrowLong />
          </a>
        </article>
      ))
    }
  </div>
  <Image src={goodToKnow} alt="" width={338} data-reveal="zoom" class="absolute bottom-6 left-[27px] w-[140px] lg:top-[613px] lg:bottom-auto lg:-left-6 lg:w-[169px]" />
</section>
