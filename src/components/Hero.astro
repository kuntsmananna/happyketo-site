---
/** Split hero as on the original: photo half (left) + cream text half with wordmark, title and mustard CTA. */
import { Image } from 'astro:assets';
import { homeFor } from '@/data/home';
import { getLang, localized } from '@/i18n';
import heroImg from '@/assets/home/hero-crepes.jpg';

const lang = getLang(Astro.url);
const c = homeFor(lang).hero;
---

<section class="grid bg-cream-100 lg:min-h-[min(calc(100dvh-5rem),48rem)] lg:grid-cols-2">
  <div class="flex flex-col items-center justify-center px-6 py-12 text-center sm:py-16 lg:px-12">
    <p class="wordmark text-2xl text-forest-600 sm:text-4xl" dir="ltr">{c.wordmark}</p>
    <h1
      class:list={[
        'mt-5 max-w-xl leading-[1.2] text-forest-600',
        c.titleSerif ? 'font-serif text-4xl italic sm:text-5xl' : 'text-4xl sm:text-5xl',
      ]}
    >
      {c.title}
    </h1>
    <p class="mt-5 max-w-md text-lg leading-relaxed text-forest-700 sm:text-xl">{c.text}</p>
    <a href={`${localized('/challenge', lang)}#register`} class="btn-primary mt-8 px-8 text-base">{c.cta}</a>
  </div>

  <div class="relative order-first h-[min(62vw,24rem)] lg:order-none lg:h-auto">
    <Image
      src={heroImg}
      alt={c.imageAlt}
      widths={[480, 720, 960, 1086]}
      sizes="(min-width: 1024px) 50vw, 100vw"
      class="absolute inset-0 size-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>
