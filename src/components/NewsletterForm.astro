---
/**
 * "Stay in touch" as on the original. Desktop: navy section, arched photo on the left, lime panel running to the
 * page edge with the egg sticker on its corner, underlined email field and a square green button.
 * Phones (original mobile layout): lime panel only, full-width button.
 * Photo: the original used a Wix stock photo (licensed for Wix only), so this is Anna's own pancakes photo.
 */
import { Image } from 'astro:assets';
import Web3Form from './Web3Form.astro';
import { homeFor } from '@/data/content';
import { dirOf, getLang } from '@/i18n';
import photo from '@/assets/posts/cfc025_e74ea0b6525b430f8abb8afd91247984.jpg';
import sticker from '@/assets/brand/sticker-happy-keto.png';

const lang = getLang(Astro.url);
const c = homeFor(lang).newsletter;
---

<section class="bg-lime-100 lg:surface-navy lg:h-[785px]" aria-labelledby="newsletter-title">
  <div class="relative lg:h-full" dir="ltr">
    <Image
      src={photo}
      alt=""
      width={853}
      height={1112}
      fit="cover"
      widths={[531, 853]}
      sizes="531px"
      data-reveal="fade"
      class="absolute top-1.5 left-[115px] hidden h-[692px] w-[531px] rounded-t-full object-cover lg:block"
    />
    <div data-reveal data-reveal-delay="150" class="px-[7%] pt-14 pb-9 lg:absolute lg:top-[160px] lg:right-0 lg:left-[646px] lg:h-[418px] lg:bg-lime-100 lg:px-0 lg:pt-[98px] lg:pb-0">
      <Image src={sticker} alt="" width={200} data-reveal="zoom" data-reveal-delay="600" class="absolute top-[-62px] left-[79px] hidden w-[100px] lg:block" />
      <div class="text-forest-600 lg:ms-auto lg:me-[95px] lg:w-[473px]" dir={dirOf(lang)}>
        <h2 id="newsletter-title" class="h-section">{c.title}</h2>
        <p class="text-body mt-3 text-forest-800">{c.text}</p>
        <Web3Form subject={c.subject} successMessage={c.success} class="mt-10 lg:mt-12">
          <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:gap-[13px]">
            <label class="flex-1">
              <span class="sr-only">{c.email}</span>
              <input
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder={c.email}
                dir="ltr"
                class="min-h-11 w-full border-0 border-b-2 border-forest-800 bg-transparent px-0 text-lg text-forest-900 placeholder:text-forest-600 focus:border-forest-900 focus:ring-0 focus:outline-none user-invalid:border-red-600 rtl:text-end rtl:placeholder:text-end"
              />
            </label>
            <button type="submit" class="btn-secondary btn-lg w-full lg:w-auto lg:[--btn-w:8rem]">
              {c.cta}
            </button>
          </div>
        </Web3Form>
      </div>
    </div>
  </div>
</section>
