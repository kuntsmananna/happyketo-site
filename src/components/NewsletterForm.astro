---
/** "Stay in touch" – lime panel beside an arched photo, single email field (as on the original). */
import { Image } from 'astro:assets';
import Web3Form from './Web3Form.astro';
import { homeFor } from '@/data/home';
import { getLang } from '@/i18n';
import photo from '@/assets/posts/cfc025_e74ea0b6525b430f8abb8afd91247984.jpg';
import sticker from '@/assets/brand/sticker-happy-keto.png';

const lang = getLang(Astro.url);
const c = homeFor(lang).newsletter;
---

<section class="overflow-x-clip bg-cream-100 section-y" aria-labelledby="newsletter-title">
  <div class="container-page grid items-center lg:grid-cols-[1fr_1.3fr]">
    <div class="relative z-10 mx-auto w-full max-w-sm lg:-me-16">
      <Image
        src={photo}
        alt=""
        width={600}
        height={760}
        fit="cover"
        widths={[320, 480, 600]}
        sizes="(min-width: 1024px) 24rem, 80vw"
        class="aspect-[600/760] w-full rounded-t-full object-cover shadow-[var(--shadow-card)]"
      />
      <Image src={sticker} alt="" width={120} class="absolute -top-6 -end-4 w-20 rotate-[8deg] drop-shadow-md" />
    </div>

    <div class="-mt-16 bg-lime-100 px-6 pt-24 pb-12 sm:px-12 lg:mt-0 lg:py-16 lg:ps-28">
      <h2 id="newsletter-title" class="h-section">{c.title}</h2>
      <p class="mt-3 text-lg text-forest-800">{c.text}</p>
      <Web3Form subject={c.subject} successMessage={c.success} class="mt-8 max-w-md">
        <div class="flex items-end gap-4">
          <label class="flex-1">
            <span class="sr-only">{c.email}</span>
            <input
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder={c.email}
              dir="ltr"
              class="min-h-12 w-full border-0 border-b-2 border-forest-600 bg-transparent px-1 text-lg text-forest-900 placeholder:text-forest-600/70 focus:border-forest-800 focus:ring-0 focus:outline-none user-invalid:border-red-600 rtl:text-end rtl:placeholder:text-end"
            />
          </label>
          <button type="submit" class="btn-secondary">{c.cta}</button>
        </div>
      </Web3Form>
    </div>
  </div>
</section>
