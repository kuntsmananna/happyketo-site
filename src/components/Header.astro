---
/**
 * Site header as on the original: deep-green bar, centered lime "HAPPY KETO" wordmark,
 * flag language switch on the left and a lime "Menu" pill on the right that opens a side panel.
 * Phones (as the original's mobile site): wordmark left, flag dropdown, three-line menu icon right.
 */
import Icon from './Icon.astro';
import Flag from './Flag.astro';
import { navFor, type NavItem } from '@/data/site';
import { alternates, getLang } from '@/i18n';
import { t } from '@/i18n/ui';

const lang = getLang(Astro.url);
const s = t(lang);
const nav = navFor(lang);
const homeHref = lang === 'en' ? '/en' : '/';
const alt = alternates(Astro.url.pathname);
// The switch goes to the same page in the other language, or to its home page.
const hrefFor = (l: 'he' | 'en') => (l === lang ? Astro.url.pathname : l === 'en' ? (alt.en ?? '/en') : (alt.he ?? '/'));
const langs = [
  { code: 'he', label: 'עברית' },
  { code: 'en', label: 'English' },
] as const;
const other = langs.find((l) => l.code !== lang)!;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href;
const isSection = (href: string) => href !== '/' && href !== '/en' && (path === href || path.startsWith(href + '/'));
const active = (href: string) => isCurrent(href) || isSection(href);
const hl = (i: NavItem) => (i.hreflang ? { hreflang: i.hreflang } : {});
---

<header class="sticky top-0 z-40 bg-forest-600 text-lime-100 [view-transition-name:site-header] print:hidden">
  <div class="relative flex h-24 items-center justify-between px-3 sm:px-6 lg:h-[81px] lg:px-12" dir="ltr">
    <!-- Language switch: two flag segments (desktop) / flag dropdown (phones) -->
    <div class="order-2 ms-auto me-3 sm:me-5 lg:order-1 lg:ms-0 lg:me-0">
      <div class="hidden h-[38px] overflow-hidden rounded-full border border-lime-100/80 lg:flex" role="group" aria-label={s.langSwitch.label}>
        {
          langs.map((l) =>
            l.code === lang ? (
              <span class="grid w-[58px] place-items-center bg-lime-100" aria-current="true">
                <Flag code={l.code} size={17} />
                <span class="sr-only">{l.label}</span>
              </span>
            ) : (
              <a href={hrefFor(l.code)} hreflang={l.code} lang={l.code} class="grid w-[58px] place-items-center transition-colors hover:bg-white/10">
                <Flag code={l.code} size={17} />
                <span class="sr-only">{l.label}</span>
              </a>
            ),
          )
        }
      </div>
      <details class="group relative lg:hidden" data-lang-menu>
        <summary class="flex h-11 cursor-pointer list-none items-center gap-2 rounded-full border border-lime-100 px-3 transition-colors hover:bg-white/10 [&::-webkit-details-marker]:hidden">
          <Flag code={lang} size={20} />
          <Icon name="chevron" size={16} class="transition-transform group-open:rotate-180" />
          <span class="sr-only">{s.langSwitch.label}</span>
        </summary>
        <a
          href={hrefFor(other.code)}
          hreflang={other.code}
          lang={other.code}
          class="absolute top-full left-0 mt-2 flex min-h-11 items-center gap-2 rounded-2xl bg-lime-100 px-4 text-forest-700 shadow-lg"
        >
          <Flag code={other.code} size={20} />
          {other.label}
        </a>
      </details>
    </div>

    <a
      href={homeHref}
      class="wordmark order-1 text-[1.45rem] text-lime-100 lg:absolute lg:left-1/2 lg:-translate-x-1/2 lg:text-[2.3rem]"
      aria-label={s.homeLabel}
    >
      HAPPY KETO
    </a>

    <!-- Recipes shortcut (an addition, Anna's choice: recipes are the main reason people visit) -->
    <div class="order-3 flex items-center gap-4 lg:gap-7">
    <a
      href="/recipes"
      hreflang={lang === 'en' ? 'he' : undefined}
      class:list={[
        'relative inline-flex min-h-11 items-center text-[1.05rem] transition-colors hover:text-mustard-400 lg:text-lg',
        "after:absolute after:inset-x-0 after:bottom-2 after:h-px after:origin-center after:scale-x-0 after:bg-current after:transition-transform after:duration-300 hover:after:scale-x-100",
        isSection('/recipes') && 'after:scale-x-100',
      ]}
      aria-current={isCurrent('/recipes') ? 'page' : undefined}
      lang={lang === 'en' ? 'en' : undefined}
    >
      {s.recipesLink}
    </a>
    <button
      type="button"
      class="inline-flex items-center gap-2.5 lg:h-[38px] lg:w-[117px] lg:justify-center lg:rounded-full lg:bg-lime-100 lg:text-forest-600 lg:transition-colors lg:hover:bg-mustard-400"
      aria-haspopup="dialog"
      aria-controls="site-menu"
      data-menu-open
    >
      <span class="hidden lg:inline" lang="en">Menu</span>
      <span aria-hidden="true" class="hidden size-[7px] rounded-full bg-forest-600 lg:block"></span>
      <!-- Phones: the original's staggered three-line icon -->
      <span aria-hidden="true" class="grid w-8 gap-[5px] p-1 lg:hidden">
        <span class="h-[3px] w-5 rounded-full bg-lime-100"></span>
        <span class="h-[3px] w-8 rounded-full bg-lime-100"></span>
        <span class="ms-auto h-[3px] w-4 rounded-full bg-lime-100"></span>
      </span>
      <span class="sr-only">{s.menuOpen}</span>
    </button>
    </div>
  </div>
</header>

<!-- Side menu panel (as on the original: green panel from the right, centered links, lime close button) -->
<dialog
  id="site-menu"
  aria-label={s.nav}
  class="fixed inset-y-0 right-0 left-auto m-0 h-dvh max-h-none w-full max-w-none bg-forest-600 p-0 text-lime-100 lg:w-[60%]"
  data-menu
>
  <div class="flex h-[81px] items-center justify-end px-6 lg:px-[60px]" dir="ltr">
    <button type="button" class="grid size-9 place-items-center rounded-full bg-lime-100 text-forest-900 transition-colors hover:bg-mustard-400" data-menu-close>
      <Icon name="close" size={20} />
      <span class="sr-only">{s.menuClose}</span>
    </button>
  </div>
  <nav aria-label={s.nav} class="px-6 pt-10 pb-12">
    <ul class="mx-auto flex max-w-md flex-col items-center text-xl">
      {
        nav.map((item, i) => (
          <li class="w-full text-center" style={`--i:${i}`}>
            {item.children ? (
              <>
                <div class="relative">
                  <a
                    href={item.href}
                    {...hl(item)}
                    class:list={['inline-block py-1 hover:text-mustard-400', active(item.href) && 'text-mustard-400']}
                    aria-current={isCurrent(item.href) ? 'page' : undefined}
                  >
                    {item.label}
                    {item.hreflang && <span class="ms-1.5 text-base opacity-70">(Hebrew)</span>}
                  </a>
                  <button
                    type="button"
                    class="group absolute top-1/2 left-0 grid size-11 -translate-y-1/2 place-items-center hover:text-mustard-400"
                    aria-expanded="false"
                    aria-controls="menu-sub"
                    data-sub-toggle
                  >
                    <Icon name="chevron" size={16} class="transition-transform group-aria-expanded:rotate-180" />
                    <span class="sr-only">{`${s.submenu} ${item.label}`}</span>
                  </button>
                </div>
                <ul id="menu-sub" class="hidden pb-2 text-lg" data-sub>
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        {...hl(child)}
                        class:list={['inline-block py-0.5 text-lime-100/85 hover:text-mustard-400', isCurrent(child.href) && 'text-mustard-400']}
                        aria-current={isCurrent(child.href) ? 'page' : undefined}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            ) : (
              <a
                href={item.href}
                {...hl(item)}
                class:list={['inline-block py-1 hover:text-mustard-400', active(item.href) && 'text-mustard-400']}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
                {item.hreflang && <span class="ms-1.5 text-base opacity-70">(Hebrew)</span>}
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </nav>
</dialog>

<style>
  /* Slide in from the right and out again; the backdrop fades. Links fade up one after another. */
  dialog {
    translate: 100% 0;
    transition:
      translate 0.45s var(--ease-out-soft),
      overlay 0.45s allow-discrete,
      display 0.45s allow-discrete;
  }
  dialog[open] {
    translate: 0 0;
  }
  @starting-style {
    dialog[open] {
      translate: 100% 0;
    }
  }
  dialog::backdrop {
    background-color: rgb(0 0 0 / 0);
    transition:
      background-color 0.45s,
      overlay 0.45s allow-discrete,
      display 0.45s allow-discrete;
  }
  dialog[open]::backdrop {
    background-color: rgb(0 0 0 / 0.3);
  }
  @starting-style {
    dialog[open]::backdrop {
      background-color: rgb(0 0 0 / 0);
    }
  }
  dialog[open] nav > ul > li {
    animation: menu-item 0.5s var(--ease-out-soft) both;
    animation-delay: calc(0.12s + var(--i, 0) * 0.05s);
  }
  @keyframes menu-item {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }
  :global(html:has(dialog[open])) {
    overflow: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    dialog,
    dialog::backdrop {
      transition: none;
    }
    dialog[open] nav > ul > li {
      animation: none;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-menu]');
  const opener = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  opener?.addEventListener('click', () => {
    document.querySelector<HTMLDetailsElement>('[data-lang-menu]')?.removeAttribute('open');
    dialog?.showModal();
  });
  dialog?.querySelector('[data-menu-close]')?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('click', (e) => {
    // A click on the backdrop (outside the panel) or on a link closes the menu.
    if (e.target === dialog) {
      const r = dialog.getBoundingClientRect();
      if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) dialog.close();
    }
    if ((e.target as HTMLElement).closest('a')) dialog.close();
  });
  dialog?.addEventListener('close', () => opener?.focus());

  const subToggle = dialog?.querySelector<HTMLButtonElement>('[data-sub-toggle]');
  const sub = dialog?.querySelector<HTMLElement>('[data-sub]');
  subToggle?.addEventListener('click', () => {
    const open = subToggle.getAttribute('aria-expanded') !== 'true';
    subToggle.setAttribute('aria-expanded', String(open));
    sub?.classList.toggle('hidden', !open);
  });

  // Close the phone language dropdown when tapping elsewhere.
  const langMenu = document.querySelector<HTMLDetailsElement>('[data-lang-menu]');
  document.addEventListener('click', (e) => {
    if (langMenu?.open && !langMenu.contains(e.target as Node)) langMenu.open = false;
  });
</script>
