---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import PostCard from '@/components/PostCard.astro';
import { getPosts } from '@/lib/recipes';

const posts = await getPosts();
---

<BaseLayout
  title="בלוג דל פחמימות"
  description="מאמרים ומדריכים על תזונה קטוגנית, פליאו ודלת פחמימות: איך מתחילים, מה אוכלים, קריאת תוויות, טיולים ועוד."
>
  <PageHero
    marquee="Blog"
    title="מידע בנושא תזונה דלת פחמימות"
    intro="כל מה שחשוב לדעת לתהליך מוצלח במעבר לתזונה טבעית קטוגנית."
  />
  <section class="mx-auto max-w-[1280px] px-[6%] pt-8 pb-16 lg:px-5 lg:pt-5 lg:pb-24">
    <div class="grid gap-8 sm:grid-cols-2">
      {posts.map((post, i) => <PostCard post={post} eager={i < 3} headingLevel={2} />)}
    </div>
  </section>
</BaseLayout>
