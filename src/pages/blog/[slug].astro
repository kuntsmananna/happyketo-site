---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/JsonLd.astro';
import ReviewNote from '@/components/ReviewNote.astro';
import RelatedPosts from '@/components/RelatedPosts.astro';
import ShareRow from '@/components/ShareRow.astro';
import Prose from '@/components/Prose.astro';
import { getPosts, pendingReview, postUrl, type Post } from '@/lib/recipes';
import { postJsonLd } from '@/lib/schema';
import { ogCardFor } from '@/lib/og';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}

interface Props {
  post: Post;
  all: Post[];
}

const { post, all } = Astro.props;
const { title, description, image, imageAlt, tags } = post.data;
const review = pendingReview(post);
const { Content } = await render(post);
const url = new URL(postUrl(post), Astro.site).href;
const shareImage = image ? await getImage({ src: image, width: 1200, format: 'jpg' }) : undefined;

const related = all
  .filter((p) => p.id !== post.id)
  .map((p) => ({ p, score: p.data.tags.filter((t) => tags.includes(t)).length }))
  .sort((a, b) => b.score - a.score || b.p.data.publishDate.getTime() - a.p.data.publishDate.getTime())
  .slice(0, 3)
  .map((x) => x.p);
---

<BaseLayout title={title} description={description || title} ogImage={ogCardFor(post) ?? shareImage?.src} ogType="article">
  <JsonLd data={postJsonLd(post, url, shareImage ? new URL(shareImage.src, Astro.site).href : undefined)} />

  <!-- One 740px column, as on the original: title, photo, the post, tags, share, related. -->
  <article class:list={['mx-auto w-[89%] pt-10 lg:w-[740px] lg:pt-[100px]', review?.parts.includes('image') && 'review-images']}>
    <h1 data-reveal class="h-section">{title}</h1>
    {review && <ReviewNote note={review.note} wixUrl={post.data.wixUrl} />}
    {
      image && (
        <Image
          src={image}
          alt={imageAlt ?? title}
          width={1480}
          widths={[480, 740, 1110, 1480]}
          sizes="(min-width: 1024px) 740px, 89vw"
          class:list={['mt-12 w-full', review?.parts.includes('image') && 'review-photo']}
          loading="eager"
          fetchpriority="high"
        />
      )
    }
    <Prose class="mt-0">
      <Content />
    </Prose>

    {
      tags.length > 0 && (
        <div class="mt-12 border-t border-bark-300/60 pt-5 text-sm text-bark-800">
          <h2 class="font-sans text-sm text-bark-800">תיוגים:</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {tags.map((t) => (
              <li class="inline-flex min-h-[31px] items-center border border-bark-300 px-3">{t}</li>
            ))}
          </ul>
        </div>
      )
    }
    <div class="mt-6"><ShareRow url={url} /></div>
  </article>

  <RelatedPosts label="עוד מהבלוג" items={related.map((p) => ({ title: p.data.title, href: postUrl(p), image: p.data.image }))} />
</BaseLayout>
