---
/**
 * Everything Claude changed in recipes/posts that Anna hasn't approved yet (temporary review aid before launch):
 * first the changes visible on the page (purple marks), then the Google descriptions and photo descriptions
 * (not visible on the page) as one table showing their current text. Not linked from the menu, not in the sitemap.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { isInvisiblePart, reviewPartLabel, reviewPartSlugs } from '@/data/review';
import { entryUrl, getPosts, getRecipes, invisibleReviewTexts, reviewSplit } from '@/lib/recipes';

const [recipes, posts] = await Promise.all([getRecipes(), getPosts()]);
const all = [...recipes, ...posts].flatMap((e) => {
  const split = reviewSplit(e);
  if (!split) return [];
  const texts = Object.fromEntries(invisibleReviewTexts(e).map((t) => [t.part, t.texts]));
  return [{ kind: e.collection === 'recipes' ? 'מתכון' : 'בלוג', title: e.data.title, href: entryUrl(e), wix: e.data.wixUrl, ...split, texts }];
});
const pageChanges = all.filter((i) => i.visible.length);
const descriptionDrafts = all.filter((i) => i.invisible.length);
const columns = reviewPartSlugs.filter(isInvisiblePart);
const unchanged = 'ללא שינוי';
---

<BaseLayout title="שינויים לבדיקה" noindex>
  <section class="mx-auto w-[89%] py-12 lg:w-[900px] lg:py-20">
    <h1 class="h-section">שינויים לבדיקה</h1>
    <p class="text-body mt-3 text-bark-700">
      מה ש-Claude שינה ועוד לא אישרת. אישור פריט: בפאנל הניהול פותחים אותו ← "שינוי לבדיקה" ← מסמנים "אישרתי" ושומרים.
      רוצה לאשר הרבה בבת אחת? אפשר פשוט לכתוב ל-Claude, למשל "מאשרת את כל התיאורים חוץ מ...".
    </p>
    {all.length === 0 && <p class="mt-10 rounded-2xl bg-mint-100 px-5 py-4 text-lg text-forest-700">אין שינויים שמחכים לבדיקה 🎉</p>}

    {
      pageChanges.length > 0 && (
        <>
          <h2 class="h-section mt-12 text-forest-700">שינויים בעמודים ({pageChanges.length})</h2>
          <p class="mt-1 text-base text-bark-700">בכל עמוד החלקים שהשתנו מסומנים בסגול, עם קישור לפוסט המקורי ב-Wix.</p>
          <ol class="mt-5 space-y-4">
            {pageChanges.map((i) => (
              <li class="rounded-2xl border-2 border-review-200 bg-white px-5 py-4">
                <p class="text-sm text-bark-500">
                  {i.kind} · {i.visible.map(reviewPartLabel).join(', ')}
                </p>
                <a href={i.href} class="mt-1 block text-xl font-bold text-forest-700 underline-offset-4 hover:underline">{i.title}</a>
                {i.review.note && <p class="mt-2 whitespace-pre-line text-base text-review-700">{i.review.note}</p>}
                {i.wix && <a href={i.wix} target="_blank" rel="noopener" class="mt-2 inline-block text-sm text-bark-700 underline">הפוסט המקורי ב-Wix</a>}
              </li>
            ))}
          </ol>
        </>
      )
    }

    {
      descriptionDrafts.length > 0 && (
        <>
          <h2 class="h-section mt-14 text-forest-700">תיאורים לגוגל ולתמונות ({descriptionDrafts.length})</h2>
          <p class="mt-1 text-base text-bark-700">
            "{reviewPartLabel('description')}" מופיע מתחת לכותרת בתוצאות החיפוש. תיאורי התמונות מוקראים לגולשים עיוורים ועוזרים בחיפוש תמונות.
            הם לא נראים בעמוד עצמו. הטקסט בטבלה הוא הטקסט הנוכחי – אם תערכי אותו בפאנל, תראי כאן את הנוסח שלך.
          </p>
          <div class="mt-5 overflow-x-auto rounded-2xl bg-white" tabindex="0" role="region" aria-label="טבלת התיאורים לבדיקה">
            <table class="w-full min-w-[48rem] text-base">
              <thead>
                <tr class="border-b border-cream-200 text-bark-500">
                  <th class="px-4 py-3 text-start font-normal">פריט</th>
                  {columns.map((c) => <th class="px-4 py-3 text-start font-normal">{reviewPartLabel(c)}</th>)}
                </tr>
              </thead>
              <tbody>
                {descriptionDrafts.map((i) => (
                  <tr class="border-b border-cream-100 align-top">
                    <td class="px-4 py-3"><a href={i.href} class="font-bold text-forest-700 hover:underline">{i.title}</a></td>
                    {columns.map((c) => {
                      const texts = i.texts[c] ?? [];
                      return (
                        <td class:list={['px-4 py-3', texts.length ? 'text-review-700' : 'text-bark-500']}>
                          {texts.length > 1 ? <ul class="list-disc ps-4">{texts.map((t) => <li>{t}</li>)}</ul> : (texts[0] ?? unchanged)}
                        </td>
                      );
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      )
    }
  </section>
</BaseLayout>
