---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { recipeCategories } from '@/data/categories';
import sticker from '@/assets/brand/sticker-happy-keto.png';
---

<BaseLayout title="העמוד לא נמצא" noindex>
  <section class="container-page py-16 text-center sm:py-24">
    <Image src={sticker} alt="" width={180} class="mx-auto w-32 rotate-[-8deg] drop-shadow-lg sm:w-40" loading="eager" />
    <p class="mt-8 text-sm font-medium tracking-[0.18em] text-cocoa-500"><span dir="ltr">404</span></p>
    <h1 class="mt-2 text-4xl sm:text-5xl">אופס, העמוד הזה לא נמצא</h1>
    <p class="mx-auto mt-4 max-w-md text-lg text-cocoa-700">
      אולי הוא עבר דירה כשהאתר התחדש. אבל יש פה הרבה דברים טעימים אחרים:
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/recipes" class="btn-primary">
        לכל המתכונים
        <Icon name="arrow" size={18} />
      </a>
      <a href="/" class="btn-secondary">לעמוד הבית</a>
    </div>
    <ul class="mx-auto mt-10 flex max-w-2xl flex-wrap justify-center gap-2">
      {
        recipeCategories.map((c) => (
          <li>
            <a
              href={`/recipes/category/${c.slug}`}
              class="block rounded-full border border-olive-200 bg-white px-4 py-2 text-sm text-cocoa-800 transition-colors hover:border-olive-400"
            >
              {c.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
