---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/JsonLd.astro';
import Prose from '@/components/Prose.astro';
import RecipeBox from '@/components/RecipeBox.astro';
import RelatedPosts from '@/components/RelatedPosts.astro';
import ShareRow from '@/components/ShareRow.astro';
import SplitContent from '@/components/SplitContent.astro';
import { categoryLabel, categoryUrl, getRecipes, recipeUrl, type Recipe } from '@/lib/recipes';
import { recipeJsonLd } from '@/lib/schema';

export async function getStaticPaths() {
  const recipes = await getRecipes();
  return recipes.map((recipe) => ({ params: { slug: recipe.id }, props: { recipe, all: recipes } }));
}

interface Props {
  recipe: Recipe;
  all: Recipe[];
}

const { recipe, all } = Astro.props;
const { title, description, image, imageAlt, category, tags } = recipe.data;
const { Content } = await render(recipe);
const url = new URL(recipeUrl(recipe), Astro.site).href;

// Social/structured-data image: a 1200px JPEG of the cover.
const shareImage = image ? await getImage({ src: image, width: 1200, format: 'jpg' }) : undefined;
const shareImageUrl = shareImage ? new URL(shareImage.src, Astro.site).href : undefined;

// Related: most shared categories first, then newest.
const related = all
  .filter((r) => r.id !== recipe.id && r.data.image)
  .map((r) => ({ r, score: r.data.category.filter((c) => category.includes(c)).length }))
  .filter((x) => x.score > 0)
  .sort((a, b) => b.score - a.score || b.r.data.publishDate.getTime() - a.r.data.publishDate.getTime())
  .slice(0, 3)
  .map((x) => x.r);

---

<BaseLayout title={title} description={description || `${title} – מתכון קטוגני ודל פחמימות`} ogImage={shareImage?.src} ogType="article">
  <JsonLd data={recipeJsonLd(recipe, url, shareImageUrl)} />

  <!-- One 740px column, as on the original: title, intro, photo, the recipe, the rest of the post, tags, share, related. -->
  <article class="mx-auto w-[89%] pt-10 lg:w-[740px] lg:pt-[100px]">
    <h1 class="text-[2rem] leading-[1.2] lg:text-[2.3rem]">{title}</h1>
    <Prose class="mt-5">
      <SplitContent>
        <Content />
        <Fragment slot="insert">
          {
            image && (
              <Image
                src={image}
                alt={imageAlt ?? title}
                width={1480}
                widths={[480, 740, 1110, 1480]}
                sizes="(min-width: 1024px) 740px, 89vw"
                class="!my-0 w-full"
                loading="eager"
                fetchpriority="high"
              />
            )
          }
          <RecipeBox recipe={recipe} />
        </Fragment>
      </SplitContent>
    </Prose>

    <div class="mt-12 border-t border-bark-300/60 pt-5 text-sm text-bark-800 print:hidden">
      {
        tags.length > 0 && (
          <>
            <h2 class="font-sans text-sm text-bark-800">תיוגים:</h2>
            <ul class="mt-3 flex flex-wrap gap-2">
              {tags.map((t) => (
                <li>
                  <a href={`/recipes?q=${encodeURIComponent(t)}`} class="inline-flex min-h-[31px] items-center border border-bark-300 px-3 hover:border-forest-600 hover:text-forest-700">
                    {t}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }
      <ul class="mt-6 flex flex-wrap gap-x-4">
        {category.map((c) => (
          <li>
            <a href={categoryUrl(c)} class="inline-flex min-h-11 items-center hover:underline">{categoryLabel(c)}</a>
          </li>
        ))}
        <li><a href="/recipes" class="inline-flex min-h-11 items-center hover:underline">מתכונים</a></li>
      </ul>
    </div>
    <div class="mt-6"><ShareRow url={url} /></div>
  </article>

  {related.length > 0 && <RelatedPosts label="עוד מתכונים" items={related.map((r) => ({ title: r.data.title, href: recipeUrl(r), image: r.data.image }))} />}
</BaseLayout>
