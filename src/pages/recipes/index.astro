---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import RecipeCatalog from '@/components/RecipeCatalog.astro';
import { getRecipes } from '@/lib/recipes';

const recipes = await getRecipes();
---

<BaseLayout
  title="מתכונים קטוגניים"
  description="מתכונים קטוגניים ודלי פחמימות: מאפים, קינוחים, בשר, דגים, ירקות, מרקים, ממרחים ומתכוני פליאו. בלי סוכר ובלי קמח, פשוטים וטעימים."
>
  <PageHero
    eyebrow="Tasty Keto"
    title="מתכונים דלי פחמימות"
    intro="שעושים שמח לגוף ולנשמה. אם אתם מודאגים שלא יהיה לכם מה לאכול, הסירו דאגה מליבכם!"
    breadcrumbs={[{ label: 'מתכונים' }]}
  />
  <RecipeCatalog recipes={recipes} all={recipes} />
</BaseLayout>
