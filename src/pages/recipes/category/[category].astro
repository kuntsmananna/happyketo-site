---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import RecipeCatalog from '@/components/RecipeCatalog.astro';
import { recipeCategories } from '@/data/categories';
import { getRecipes } from '@/lib/recipes';

export async function getStaticPaths() {
  const all = await getRecipes();
  return recipeCategories
    .map((category) => ({ category, recipes: all.filter((r) => r.data.category.includes(category.slug)) }))
    .filter(({ recipes }) => recipes.length > 0)
    .map(({ category, recipes }) => ({ params: { category: category.slug }, props: { category, recipes, all } }));
}

const { category, recipes, all } = Astro.props;
const title = category.slug === 'paleo' ? 'מתכוני פליאו' : `מתכוני ${category.label}`;
const bandWord: Record<string, string> = { paleo: 'Paleo', pastry: 'Pastry', meat: 'Meat', fish: 'Fish', soups: 'Soups', eggs: 'Eggs', vegetables: 'Vegetables', desserts: 'Desserts', spreads: 'Spreads', drinks: 'Drinks' };
---

<BaseLayout title={`${title} קטוגניים`} description={`${recipes.length} ${title} קטוגניים ודלי פחמימות מהמטבח של Happy Keto: פשוטים, טעימים, בלי סוכר ובלי קמח.`}>
  <PageHero
    variant="marquee"
    marquee={bandWord[category.slug] ?? 'Recipes'}
    title={title}
    intro={`${recipes.length} מתכונים דלי פחמימות, פשוטים וטעימים.`}
    breadcrumbs={[{ label: 'מתכונים', href: '/recipes' }, { label: category.label }]}
  />
  <RecipeCatalog recipes={recipes} all={all} active={category.slug} />
</BaseLayout>
