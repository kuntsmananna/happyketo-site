---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Icon from '@/components/Icon.astro';
import JsonLd from '@/components/JsonLd.astro';
import { site } from '@/data/site';
import anna from '@/assets/home/anna.jpg';
import selfie from '@/assets/home/anna-kitchen-selfie.jpg';
import stickerLowCarb from '@/assets/brand/sticker-low-carb.png';
import stickerHappy from '@/assets/brand/sticker-happy-keto.png';

// Anna's story from the original "אודות" page.
const story = [
  'אני אנה, ואני חיה ״בקצב גבוה״, לא נחה לדקה אבל בעיקר עקשנית.',
  'העקשנות לא לוותר על דברים או לבחור משהו על חשבון משהו אחר. פשוט לא מוכנה להשלים עם המשפט הזה. אני מאמינה שאפשר להספיק הכל וכן להנות מכל העולמות!',
  'אני גרה ביפו, נשואה לניצן ושתי יצורות מקסימות בשם שירה ורוני הפכו אותי לאמא.',
  'למדתי עיצוב ובמשך עשור הייתי מנהלת קריאטיב ב-wix, הקמתי וניהלתי צוותי עיצוב בארץ ובחו״ל ועבדתי עם לקוחות בינלאומיים.',
  'היה לי סופר מעניין, כיף, מפתח ומעיף! אתם יכולים לדמיין את הג׳ינגול והקצב של זוג קרייריסטים עם ילדים קטנים, רשימת מטלות שלא נגמרת ורק 24 שעות ביום (איך יש רק 24 שעות?!?! ולמי יש זמן לישון בכלל?!). החלטתי שאני לא מוכנה לוותר על הבריאות שלי ואני חייבת לפצח איך בכל הצ׳יגעון הזה אני מצליחה להכניס ספורט ולאכול בריא.',
];
const story2 = [
  'התחלתי לחקור וללמוד תזונה, בעיקר מפורומים, פודקאסטים, מאמרים והרצאות באינטרנט, התעמקתי יותר ויותר.',
  'התנסתי בצמחונות, טבעונות, פליאו וקיטו. כשעברתי לתזונה קטוגנית הרגשתי שיש שינוי, שאני מתחילה לרדת במשקל ומתחילה להרגיש טוב יותר. הבנתי שמצאתי את הדבר שלי.',
  'למדתי לעומק איך מיישמים תזונה דלת פחמימות בצורה הנכונה והבריאה ובעיקר מה היתרונות הבריאותיים שלה (וזה וואו!)',
  'תוך כדי שאני כבר בקיאה בחומר עשיתי בדיקות דם (בכל זאת גיל 40 והגיע הזמן לבדק בית) ולהפתעתי (הלם/ שוק/ אמא׳לה יותר מתאימים לתיאור) גיליתי שאני שניה לפני סוכרת ויש לי עמידות גבוהה לאינסולין, שהקורטיזול (הורמון הסטרס) בגובה של עזריאלי והשינוי שאני עושה הוא לא בגדר איזו התנסות או תחביב חדש אלא ממש חובה וזו הדרך חיים שלי מהיום והלאה.',
];
const story3 = [
  'תקראו לזה ״משבר גיל 40״. אני קוראת לזה ״התפתחות גיל 40״. עשיתי פניית פרסה.',
  'עזבתי את העבודה והתחלתי להקדיש את כולי כולי לחקר התזונה הקטוגנית, היתרונות שלה והיישום שלה ביום יום (בעולם לא קטוגני בעליל). העברתי את כל המשפחה לתזונה דלת פחמימות (כולל 2 בנות, בנות 10-6), התחלתי לפתח מתכונים (תוך דגש על קלות ומהירות), להעביר הרצאות, ללוות אנשים בתהליך של שינוי ומעבר לתזונה קטוגנית או פליאו.',
  'אני מאמינה גדולה בתזונה טבעית ודלת פחמימות, פגשתי בעשרות אנשים שבעזרת התזונה הורידו (מלא) במשקל והבריאו משלל מחלות.',
  'ומה שהכי מדהים אותי בכל הסיפור הזה: שזה ממש מתחת לאף שלנו ודי בקלות ניתן לשלב תזונה מיטיבה כחלק מסדר היום שלנו עם כל לו״ז, צפוף ולחוץ ככל שיהיה.',
];
const disclosure = [
  'אינני רופאה, לא תזונאית ולא מטפלת.',
  'צברתי המון ידע ממקורות רבים, בדקתי, התנסתי ודייקתי.',
  'אני נמצאת בתזונה דלת פחמימות מזה כעשור ומקפידה על תזונה קטוגנית כשלוש שנים.',
  'ליוויתי בני משפחה, חברים ואנשים רבים אחרים ועזרתי להם לעבור לתזונה דלת פחמימות (קטוגנית או פליאו). ראיתי וחוויתי יחד איתם את השינויים המדהימים שהם עברו ואיך אורח החיים החדש היטיב ומיטיב איתם. ראיתי וחוויתי יחד איתם גם את האתגרים הפסיכולוגיים והפיסיים, האישיים והסביבתיים. מתוך נסיון זה פיתחתי ודייקתי את HAPPY KETO שהוא בית לתזונה קטוגנית, שמחה והנאה.',
];

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.author,
  url: `${site.url}/about`,
  jobTitle: 'מייסדת Happy Keto',
  address: { '@type': 'PostalAddress', addressLocality: 'יפו', addressCountry: 'IL' },
  sameAs: site.social.map((s) => s.href),
};
---

<BaseLayout title="אודות – אנה קונצמן רוזנברג" description="אני אנה: הייטקיסטית לשעבר, אמא לשתיים מיפו, שגילתה שהיא שניה לפני סוכרת – ומצאה את הדרך בתזונה קטוגנית טבעית. זה הסיפור של Happy Keto.">
  <JsonLd data={person} />

  <section class="relative overflow-hidden bg-sage-50">
    <div class="container-page grid items-center gap-10 py-10 sm:py-14 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
      <div>
        <div class="mb-6"><Breadcrumbs items={[{ label: 'אודות' }]} /></div>
        <p class="mb-2 font-medium tracking-[0.18em] text-cocoa-500"><span dir="ltr">About Happy Keto</span></p>
        <h1 class="text-4xl leading-tight sm:text-5xl">נעים מאוד, אני אנה</h1>
        <p class="mt-5 text-xl leading-relaxed text-cocoa-700">
          אתחיל מהסוף: אני הייטקיסטית עם 2 ילדות קטנות, לו״ז משוגע ואובססיה לסדר ונקיון שיודעת איך בכל הדבר המשוגע הזה שנקרא
          החיים להכניס ולשלב אוכל טעים ומזין ב-<span dir="ltr">no time</span>. איך?! אשמח לחלוק וללמד אתכם.
        </p>
      </div>
      <div class="relative mx-auto w-full max-w-lg">
        <Image
          src={anna}
          alt={`${site.author} במטבח`}
          widths={[480, 720, 960, 1400]}
          sizes="(min-width: 1024px) 32rem, 92vw"
          class="aspect-[4/3] w-full rounded-[2rem] object-cover object-[50%_30%] shadow-[var(--shadow-card)]"
          loading="eager"
          fetchpriority="high"
        />
        <Image src={stickerHappy} alt="" width={160} class="absolute -bottom-8 -start-4 w-28 rotate-[-10deg] drop-shadow-lg sm:w-32" />
      </div>
    </div>
  </section>

  <section class="container-page max-w-3xl py-14 sm:py-20">
    <div class="space-y-5 text-lg leading-relaxed text-cocoa-800">
      {story.map((p) => <p>{p}</p>)}
    </div>

    <div class="my-12 grid items-center gap-8 sm:grid-cols-[1fr_1.2fr]">
      <Image
        src={selfie}
        alt="אנה בסדנת בישול"
        widths={[400, 640, 900]}
        sizes="(min-width: 640px) 18rem, 92vw"
        class="mx-auto aspect-[3/4] w-full max-w-xs rounded-[2rem] object-cover shadow-[var(--shadow-card)]"
      />
      <div class="space-y-5 text-lg leading-relaxed text-cocoa-800">
        {story2.slice(0, 2).map((p) => <p>{p}</p>)}
      </div>
    </div>

    <div class="space-y-5 text-lg leading-relaxed text-cocoa-800">
      {story2.slice(2).map((p) => <p>{p}</p>)}
    </div>

    <blockquote class="my-12 rounded-[2rem] bg-olive-700 p-8 text-center text-cream-50 sm:p-10">
      <p class="text-2xl font-bold leading-snug sm:text-3xl">התזונה הקטוגנית חסכה ממני מחלה קשה.</p>
      <p class="mt-2 text-lg text-cream-100">ממש במקרה. באמצע החיים. איזה מזל.</p>
    </blockquote>

    <div class="space-y-5 text-lg leading-relaxed text-cocoa-800">
      {story3.map((p) => <p>{p}</p>)}
      <p class="text-xl font-medium text-olive-700">או כמו שאומרים: ״אם אני יכולה, כל אחד יכול!״</p>
      <p>אשמח לשתף וללמד את העקרונות הפשוטים אותם גיבשתי ויישמתי. אז למה לבחור אם אפשר גם וגם?!</p>
    </div>
  </section>

  <section class="bg-cream-100 py-14 sm:py-20" aria-labelledby="disclosure-title">
    <div class="container-page relative max-w-3xl">
      <Image src={stickerLowCarb} alt="" width={160} class="absolute -top-20 end-4 hidden w-28 rotate-[10deg] drop-shadow-lg sm:block" />
      <h2 id="disclosure-title" class="text-3xl">גילוי נאות</h2>
      <div class="mt-6 space-y-4 text-lg leading-relaxed text-cocoa-800">
        {disclosure.map((p) => <p>{p}</p>)}
      </div>
      <p class="mt-8 text-2xl font-bold text-olive-800">ברוכות וברוכים הבאים!</p>
      <div class="mt-8 rounded-[var(--radius-card)] border border-cream-300 bg-white/60 p-5 text-sm leading-relaxed text-cocoa-600">
        <p>* אתר זה הוא למידע בלבד ואין לראות בו ייעוץ רפואי.</p>
        <p class="mt-1">
          מטרת התכנים המופיעים באתר היא לספק מידע בנושא תזונה קטוגנית טבעית. התכנים אינם חוות דעת רפואית מקצועית. התכנים המופיעים
          בתוכנית זו נועדו להרחבת הידע האישי של המשתמשים והמשתמשות ואין לראות בהם תחליף להתייעצות עם רופא מומחה.
        </p>
      </div>
      <p class="mt-8 text-lg text-cocoa-700">שלכם/ן, {site.author}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/challenge" class="btn-primary">
          לאתגר 4 השבועות
          <Icon name="arrow" size={18} />
        </a>
        <a href="/recipes" class="btn-secondary bg-white">למתכונים</a>
      </div>
    </div>
  </section>
</BaseLayout>
