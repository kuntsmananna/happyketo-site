---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import { favoriteGroups, favorites } from '@/data/favorites';

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/favorites/*.webp', { eager: true });
const imageFor = (slug: string) => images[`/src/assets/favorites/${slug}.webp`]?.default;
---

<BaseLayout
  title="המזווה הקטוגני – מוצרים מומלצים"
  description="Happy Favorites: המוצרים שאני הכי אוהבת במטבח הקטוגני – שומנים, ממתיקים, קמחים, נשנושים ועוד. ניסיתי, אהבתי, ממליצה בחום!"
>
  <PageHero
    eyebrow="Happy Favorites"
    title="המזווה הקטוגני"
    intro="ניסיתי, אהבתי, ממליצה בחום! המוצרים שתמיד יש אצלי בבית – כולם זמינים להזמנה ב-iHerb."
    breadcrumbs={[{ label: 'מוצרים מומלצים' }]}
  >
    <nav aria-label="קטגוריות מוצרים" class="mt-6 flex flex-wrap gap-2">
      {
        favoriteGroups.map((g) => (
          <a
            href={`#${g.id}`}
            class="inline-flex min-h-11 items-center rounded-full border border-olive-200 bg-white px-4 py-2 text-sm font-medium text-cocoa-800 transition-colors hover:border-olive-400"
          >
            {g.title}
          </a>
        ))
      }
    </nav>
  </PageHero>

  <div class="container-page section-y-sm">
    <p class="mb-10 rounded-[var(--radius-card)] bg-cream-100 p-4 text-sm leading-relaxed text-cocoa-700">
      <strong class="font-medium">גילוי נאות:</strong> הקישורים לחנות הם קישורי שותפים. אם תרכשו דרכם, ייתכן שאקבל עמלה קטנה – ללא
      עלות נוספת עבורכם. אני ממליצה רק על מוצרים שאני משתמשת בהם בעצמי.
    </p>

    {
      favoriteGroups.map((group) => {
        const items = favorites.filter((f) => f.group === group.id);
        return (
          <section id={group.id} class="mb-14 scroll-mt-28" aria-labelledby={`${group.id}-title`}>
            <div class="mb-6">
              <h2 id={`${group.id}-title`} class="h-section">{group.title}</h2>
              <p class="mt-1 text-cocoa-600">{group.intro}</p>
            </div>
            <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
              {items.map((item) => {
                const img = imageFor(item.slug);
                return (
                  <li class="card flex flex-col overflow-hidden">
                    <div class="relative aspect-square bg-white">
                      {img && (
                        <Image
                          src={img}
                          alt={item.name}
                          widths={[240, 400, 600]}
                          sizes="(min-width: 1280px) 16rem, (min-width: 640px) 40vw, 80vw"
                          class="absolute inset-0 size-full object-contain p-6"
                        />
                      )}
                    </div>
                    <div class="flex flex-1 flex-col border-t border-olive-100 p-5">
                      <h3 class="text-lg leading-snug" dir="ltr" style="text-align: right">
                        {item.name}
                      </h3>
                      {item.note && (
                        <p class="mt-2 text-sm leading-relaxed text-cocoa-700" dir="ltr" style="text-align: right">
                          {item.note}
                        </p>
                      )}
                      <details class="group mt-3 text-sm text-cocoa-600">
                        <summary class="inline-flex cursor-pointer list-none items-center gap-1 font-medium text-olive-700 [&::-webkit-details-marker]:hidden">
                          רכיבים
                          <Icon name="chevron" size={14} class="transition-transform group-open:rotate-180" />
                        </summary>
                        <p class="mt-2 leading-relaxed" dir="ltr" style="text-align: right">
                          {item.ingredients}
                        </p>
                      </details>
                      <div class="mt-auto pt-4">
                        <a href={item.href} target="_blank" rel="sponsored noopener" class="btn-primary btn-sm">
                          לרכישה ב-iHerb
                          <Icon name="arrow" size={16} />
                        </a>
                      </div>
                    </div>
                  </li>
                );
              })}
            </ul>
          </section>
        );
      })
    }
  </div>
</BaseLayout>
