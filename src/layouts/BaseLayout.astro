---
import { Font } from 'astro:assets';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import KickstartBadge from '@/components/KickstartBadge.astro';
import { fullTitle, site } from '@/data/site';
import { alternates, dirOf, getLang, localeOf } from '@/i18n';
import { t } from '@/i18n/ui';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative image URL for social previews. */
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** Hide the floating Keto Kickstart badge (e.g. on the challenge page itself). */
  hideBadge?: boolean;
}

const lang = getLang(Astro.url);
const {
  title,
  description = lang === 'en'
    ? 'Happy Keto – a natural, simple and tasty ketogenic (keto) diet. A 4-week challenge that fits real life, with no calorie counting.'
    : site.description,
  ogImage = '/og-default.jpg',
  ogType = 'website',
  noindex = false,
  hideBadge = false,
} = Astro.props;

const pageTitle = title ? fullTitle(title) : lang === 'en' ? 'Happy Keto | Mediterranean Keto Diet' : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const alt = alternates(Astro.url.pathname);
const altLocale = lang === 'he' ? 'en' : 'he';
---

<!doctype html>
<html lang={lang} dir={dirOf(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      alt.en && !noindex && (
        <>
          <link rel="alternate" hreflang="he" href={new URL(alt.he!, Astro.site)} />
          <link rel="alternate" hreflang="en" href={new URL(alt.en, Astro.site)} />
          <link rel="alternate" hreflang="x-default" href={new URL(alt.he!, Astro.site)} />
        </>
      )
    }

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={localeOf(lang)} />
    {alt.en && <meta property="og:locale:alternate" content={localeOf(altLocale)} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    {ogImage.startsWith('/og/') && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="google-site-verification" content={site.googleSiteVerification} />
    <meta name="theme-color" content="#235b47" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <Font cssVariable="--font-alef" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-syne" />
    <Font cssVariable="--font-gelasio" />

    <slot name="head" />
    <!--
      Scroll reveal: hide [data-reveal] elements only once we know JS runs (see global.css → Motion).
      Review mode: purple review marks only on devices where Anna turned it on (/review, or ?review=on / ?review=off).
      Runs in <head> so neither flashes.
    -->
    <script is:inline>
      (function () {
        var html = document.documentElement;
        if ('IntersectionObserver' in window) html.classList.add('reveal-ready');
        try {
          var q = new URLSearchParams(location.search).get('review');
          if (q === 'on' || q === 'off') localStorage.setItem('hk-review', q);
          if (localStorage.getItem('hk-review') === 'on') html.classList.add('reviewer');
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-forest-700 focus:px-4 focus:py-2 focus:text-cream-50"
    >
      {t(lang).skip}
    </a>

    <Header />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />
    {!hideBadge && <KickstartBadge />}

    <script>
      // Reveal [data-reveal] elements as they scroll into view. Elements entering together get a short stagger
      // (90ms apart, capped), so a row of cards builds up one by one; data-reveal-delay="<ms>" overrides it.
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const show = (el: HTMLElement) => el.classList.add('is-revealed');
      if (!('IntersectionObserver' in window)) els.forEach(show);
      else {
        const io = new IntersectionObserver(
          (entries) => {
            const entering = entries.filter((e) => e.isIntersecting).map((e) => e.target as HTMLElement);
            entering.forEach((el, i) => {
              const delay = el.dataset.revealDelay ?? String(Math.min(i, 5) * 90);
              el.style.setProperty('--reveal-delay', `${delay}ms`);
              show(el);
              io.unobserve(el);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0 },
        );
        els.forEach((el) => io.observe(el));
        // Clear the delay after the entrance so hover transitions on revealed elements aren't delayed.
        document.addEventListener('transitionend', (e) => {
          const el = e.target as HTMLElement;
          if (el.classList?.contains('is-revealed')) el.style.removeProperty('--reveal-delay');
        });
      }
    </script>
  </body>
</html>
